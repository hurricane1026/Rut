diff --git a/include/simdjson/internal/rut_allocator.h b/include/simdjson/internal/rut_allocator.h
new file mode 100644
index 0000000..714fdac
--- /dev/null
+++ b/include/simdjson/internal/rut_allocator.h
@@ -0,0 +1,37 @@
+#ifndef SIMDJSON_INTERNAL_RUT_ALLOCATOR_H
+#define SIMDJSON_INTERNAL_RUT_ALLOCATOR_H
+#include <cstddef>
+#include <memory>
+#include <new>
+#include <limits>
+#include <type_traits>
+
+#ifdef SIMDJSON_RUT_ALLOCATOR
+// Embedding application owns these symbols. Return nullptr on exhaustion.
+// Deallocate must recover the original owner from the pointer, not TLS state.
+extern "C" void *simdjson_rut_allocate(size_t bytes, size_t alignment) noexcept;
+extern "C" void simdjson_rut_deallocate(void *pointer) noexcept;
+#endif
+namespace simdjson { namespace internal {
+template<class T> struct buffer_deleter {
+  void operator()(T *p) const noexcept {
+#ifdef SIMDJSON_RUT_ALLOCATOR
+    if (p) simdjson_rut_deallocate(p);
+#else
+    delete[] p;
+#endif
+  }
+};
+template<class T> using buffer_ptr = std::unique_ptr<T[], buffer_deleter<T>>;
+template<class T> inline T *allocate_buffer(size_t count) noexcept {
+  static_assert(std::is_trivial<T>::value, "Only trivial parser buffers supported");
+  if (count > (std::numeric_limits<size_t>::max)() / sizeof(T)) return nullptr;
+#ifdef SIMDJSON_RUT_ALLOCATOR
+  void *storage = simdjson_rut_allocate(count * sizeof(T), alignof(T));
+  return storage ? ::new (storage) T[count] : nullptr;
+#else
+  return new (std::nothrow) T[count];
+#endif
+}
+} }
+#endif
