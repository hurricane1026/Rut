import "middleware/auth.rut"
listen :8080

// Compile-time snapshots. Empty secrets disable slots; use TLS for credentials.
func alice() -> auth.ConsumerCredentials {
    auth.ConsumerCredentials(consumerId: "alice", key: env("ALICE_API_KEY"),
        credentials: env("ALICE_BASIC_CREDENTIALS"), keyId: "alice-key", passwordId: "alice-password")
}
func bob() -> auth.ConsumerCredentials {
    auth.ConsumerCredentials(consumerId: "bob", key: env("BOB_API_KEY"),
        credentials: env("BOB_BASIC_CREDENTIALS"), keyId: "bob-key", passwordId: "bob-password")
}

route GET "/private" {
    let identity = auth.multiAuth(req.authorization.or(""), alice(), bob())
    let consumerId = identity.consumerId
    return response(200, body: consumerId)
}
route GET "/alice-only" {
    let identity = auth.multiAuth(req.authorization.or(""), alice(), bob())
    let permitted = auth.requireConsumer(identity, "alice")
    let consumerId = permitted.consumerId
    return response(200, body: consumerId)
}
// Either exact Consumer is allowed; authentication still precedes authorization.
route GET "/allowed-consumers" {
    let identity = auth.multiAuth(req.authorization.or(""), alice(), bob())
    let permitted = auth.requireAnyConsumer(identity, "alice", "bob")
    let consumerId = permitted.consumerId
    return response(200, body: consumerId)
}
// Both credentials are mandatory, bound to one configured Consumer/policy pair.
route GET "/both-credentials" {
    let identity = auth.headerKeyAndBasic(req.uniqueHeader("X-API-Key").or(""),
        req.authorization.or(""), env("ALICE_API_KEY"), env("ALICE_BASIC_CREDENTIALS"),
        "alice", "alice-required-pair")
    let consumerId = identity.consumerId
    return response(200, body: consumerId)
}
route "/" { return 404 }
