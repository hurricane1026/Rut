// RUT_API_KEY is read at compilation/loading. Deploy behind TLS.
import "middleware/auth.rut"
listen :8080
upstream backend at "127.0.0.1:8081"

route GET "/private" {
    // Removal affects only the forwarded request. Verification below reads
    // the original request; rejected requests return locally with a challenge.
    req.remove("Authorization")
    req.remove("X-API-Key")
    let identity = auth.apiKey(req.authorization.or(""), env("RUT_API_KEY"), "example-app", "primary")
    match identity.consumerId {
        "example-app" => {
            req.set("X-Consumer-ID", identity.consumerId)
            return forward(backend, load_balance: .roundRobin)
        }
        _ => return 403
    }
}
