import "middleware/identity_auth.rut"

listen :8080

// Trusted static registries in the SAME Consumer ID namespace. Use TLS and
// replace configuration to rotate/revoke. Every credential source is required.
func alice() -> identity_auth.ConsumerCredentials {
    identity_auth.ConsumerCredentials(consumerId: "alice", key: "",
        credentials: env("ALICE_BASIC_CREDENTIALS"), keyId: "alice-disabled-bearer", passwordId: "alice-password")
}
func bob() -> identity_auth.ConsumerCredentials {
    identity_auth.ConsumerCredentials(consumerId: "bob", key: "",
        credentials: env("BOB_BASIC_CREDENTIALS"), keyId: "bob-disabled-bearer", passwordId: "bob-password")
}
func aliceKey() -> identity_auth.HeaderKeyConsumer {
    identity_auth.HeaderKeyConsumer(consumerId: "alice", key: env("ALICE_API_KEY"), credentialId: "alice-key")
}
func bobKey() -> identity_auth.HeaderKeyConsumer {
    identity_auth.HeaderKeyConsumer(consumerId: "bob", key: env("BOB_API_KEY"), credentialId: "bob-key")
}

route GET "/private" {
    // Removal affects forwarding, while auth still reads original singleton fields.
    req.remove("Authorization")
    req.remove("X-API-Key")
    let password = identity_auth.multiAuth(req.authorization.or(""), alice(), bob())
    let key = identity_auth.multiHeaderKey(req.uniqueHeader("X-API-Key").or(""), aliceKey(), bobKey())
    let identity = identity_auth.requireSameConsumer(password, key, "password-and-key")
    let consumerId = identity.consumerId
    return response(200, body: consumerId)
}

route GET "/alice-only" {
    let password = identity_auth.multiAuth(req.authorization.or(""), alice(), bob())
    let key = identity_auth.multiHeaderKey(req.uniqueHeader("X-API-Key").or(""), aliceKey(), bobKey())
    let identity = identity_auth.requireSameConsumer(password, key, "password-and-key")
    let allowed = identity_auth.requireConsumer(identity, "alice")
    let consumerId = allowed.consumerId
    return response(200, body: consumerId)
}

route "/" { return 404 }
