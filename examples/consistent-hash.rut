// Use the same nonzero 32-character lowercase hex seed on every gateway instance.
// Example: UPSTREAM_HASH_SEED=0123456789abcdef0123456789abcdef
upstream api {
    backends: ["127.0.0.1:9001": 3, "127.0.0.1:9002": 1, "127.0.0.1:9003": 0]
}

route GET "/catalog" {
    guard let tenant = req.header("X-Tenant-ID") else { return 400 }
    return forward(api, load_balance: .consistentHash,
                   hash_key: tenant, hash_seed: env("UPSTREAM_HASH_SEED"))
}
