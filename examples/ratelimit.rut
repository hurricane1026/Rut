// Rate limiting written in Rut — the blessed patterns (docs/state-types.md).
//
// These are ordinary language constructs, not built-ins: per-key state lives
// in a Cache slot, the algorithm is inline arithmetic. The compiler inlines
// everything into the route's flat state machine, so this costs the same as
// the C++ @rateLimit decorator (one hash-slot access + a few instructions).
//
// Semantics to know:
//  - time.nowMicros() is LATCHED per request: every use sees the same value.
//  - Cache is lossy per-key state: a miss means never-seen OR evicted — the
//    .or(0) fallback treats both as "fresh key", which is self-healing here.
//  - State writes (buckets.set) run at handler entry and must appear before
//    any guard/wait — this variant therefore ALWAYS meters a request, so a
//    client that keeps hammering while over limit pushes its own release
//    time further out (a punitive token bucket; conditional "meter only on
//    accept" needs branch-local writes, a future slice).
//  - Per-shard state: the effective limit is ≈ limit × shard count.

let buckets = Cache<IP, i64>(capacity: 100000)

// Token bucket (GCRA): steady rate = 1 request / emit period.
// emit = 600000µs → 100 req/min; tolerance tau = emit → burst of ~2.
// Tune by editing the two constants (i64 params on funcs arrive later).
route GET "/api" {
    let now = time.nowMicros()
    let tat = max(buckets.get(req.remoteAddr).or(0), now)
    buckets.set(req.remoteAddr, tat + 600000)
    if tat - now <= 600000 { return 200 } else { return 429 }
}

// Sliding-window counter, packed into one i64 slot:
// high 32 bits = window index (now / window length), low 32 = count.
// Window rollover is the lazy-expiry comparison — no TTL machinery.
let hits = Cache<IP, i64>(capacity: 100000)

route GET "/search" {
    let now = time.nowMicros()
    let win = now / 60000000
    let packed = hits.get(req.remoteAddr).or(0)
    let same = bitwise.shiftRight(packed, 32) - win
    let count = max(bitwise.and(packed, 4294967295) * min(same + 1, 1), 0)
    hits.set(req.remoteAddr, bitwise.or(bitwise.shiftLeft(win, 32), count + 1))
    if count + 1 <= 100 { return 200 } else { return 429 }
}
