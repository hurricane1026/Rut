import "middleware/auth.rut"

listen :8080

// Compile/load with these environment variables set. Empty previous values
// retire old credentials; empty current values allow a previous-only window.
// Use TLS. Compiled artifacts contain the configured secrets.
route GET "/basic" {
    let identity = auth.rotatingBasic(req.authorization.or(""),
        env("RUT_BASIC_CURRENT"), env("RUT_BASIC_PREVIOUS"),
        "example-app", "password-current", "password-previous")
    let allowed = auth.requireConsumer(identity, "example-app")
    let credentialId = allowed.credentialId
    return response(200, body: credentialId)
}

route GET "/header-key" {
    let identity = auth.rotatingHeaderKey(req.uniqueHeader("X-API-Key").or(""),
        env("RUT_HEADER_KEY_CURRENT"), env("RUT_HEADER_KEY_PREVIOUS"),
        "example-app", "key-current", "key-previous")
    let allowed = auth.requireConsumer(identity, "example-app")
    let credentialId = allowed.credentialId
    return response(200, body: credentialId)
}

route "/" { return 404 }
