import "clients/redis-client.rut"
import "middleware/browser_origin.rut"
import "middleware/browser_session_cookie.rut"
import "middleware/jwt_session.rut"

func allowBrowserMutation(_ tls: bool, _ origin: str, _ site: str, _ expected: str) -> bool {
    tls && browser_origin.validOrigin(expected) && origin == expected && site == "same-origin"
}

chain browserMutation {
    before allowBrowserMutation(req.isTls, req.uniqueHeader("Origin").or(""),
        req.uniqueHeader("Sec-Fetch-Site").or(""), env("BROWSER_ORIGIN")) else 403
}

func verifiedSession(_ token: str) -> Json {
    jwt_session.documentHs256(token, env("JWT_SECRET"), env("JWT_PREVIOUS_SECRET"),
        env("JWT_ISSUER"), env("JWT_AUDIENCE"))
}

func permitStatus(_ result: RedisSessionResult) -> i32 {
    match result {
        .value(data) => if data == b"active" { 1 } else { 0 }
        .missing => 0
        _ => -1
    }
}

// An application that already holds an enrolled bearer session can exchange it
// for a host-bound cookie on the same HTTPS origin.
route POST "/session/cookie" use chain browserMutation {
    let token = bearerToken(req.uniqueHeader("Authorization").or("")).or("")
    let document = verifiedSession(token)
    guard let key = jwt_session.key(token, env("JWT_SESSION_NAMESPACE")) else { return 503 }
    let opening = tcp(env("REDIS_ENDPOINT"), 1000)
    guard let connection = opening else { return 503 }
    let result = redisSessionGet(connection, Bytes(env("REDIS_USERNAME")),
        Bytes(env("REDIS_PASSWORD")), parseInt(env("REDIS_DATABASE")).or(-1), key)
    let allowed = jwt_session.requireActiveStatus(permitStatus(result))
    let responseCookie = "__Host-rut_session=" + token + "; Path=/; Secure; HttpOnly; SameSite=Strict"
    let reply = response(204)
    reply.set("Cache-Control", "no-store")
    reply.add("Set-Cookie", responseCookie)
    return reply
}

func browserSessionKey(_ token: str) -> Bytes {
    guard req.isTls else { nil }
    jwt_session.key(token, env("JWT_SESSION_NAMESPACE"))
}

route GET "/private" {
    let token = req.uniqueCookie("__Host-rut_session").or("")
    let document = verifiedSession(token)
    guard let key = browserSessionKey(token) else { return 503 }
    let opening = tcp(env("REDIS_ENDPOINT"), 1000)
    guard let connection = opening else { return 503 }
    let result = redisSessionGet(connection, Bytes(env("REDIS_USERNAME")),
        Bytes(env("REDIS_PASSWORD")), parseInt(env("REDIS_DATABASE")).or(-1), key)
    let allowed = jwt_session.requireActiveStatus(permitStatus(result))
    guard let subject = json.string(json.get(document, "/sub").or(document)) else { return 503 }
    return response(200, body: subject, headers: {"Cache-Control": "no-store"})
}

route POST "/private/write" use chain browserMutation {
    let token = req.uniqueCookie("__Host-rut_session").or("")
    let document = verifiedSession(token)
    guard jwtHasScope(document, "orders:write") else { return 403 }
    guard let key = jwt_session.key(token, env("JWT_SESSION_NAMESPACE")) else { return 503 }
    let opening = tcp(env("REDIS_ENDPOINT"), 1000)
    guard let connection = opening else { return 503 }
    let result = redisSessionGet(connection, Bytes(env("REDIS_USERNAME")),
        Bytes(env("REDIS_PASSWORD")), parseInt(env("REDIS_DATABASE")).or(-1), key)
    let status = permitStatus(result)
    guard status >= 0 else { return 503 }
    if status == 1 {
        return response(204, headers: {"Cache-Control": "no-store"})
    } else { return 401 }
}

struct Revocation { key: Bytes expiry: Bytes }

func revocationArguments(_ document: Json, _ token: str) -> Revocation {
    guard let key = jwt_session.key(token, env("JWT_SESSION_NAMESPACE")) else { nil }
    guard let expiry = json.get(document, "/exp") else { nil }
    guard let encoded = json.encode(expiry) else { nil }
    Revocation(key: key, expiry: Bytes(encoded))
}

route POST "/logout" use chain browserMutation {
    let token = req.uniqueCookie("__Host-rut_session").or("")
    let document = verifiedSession(token)
    guard let revocation = revocationArguments(document, token) else { return 503 }
    let opening = tcp(env("REDIS_ENDPOINT"), 1000)
    guard let connection = opening else { return 503 }
    let result = sessionRevokeDurable(connection, Bytes(env("REDIS_USERNAME")),
        Bytes(env("REDIS_PASSWORD")), parseInt(env("REDIS_DATABASE")).or(-1), revocation.key,
        revocation.expiry)
    guard redisReplayResultStatus(result) == 1 else { return 503 }
    let cleared = browser_session_cookie.cleared()
    return cleared
}

route "/" { return 404 }
