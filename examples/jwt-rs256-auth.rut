// Optional "requiredType":"at+jwt" pins the exact signed protected-header typ.
// Configure the issuer's actual type; no case folding or media-type aliases apply.
// JWT_RS256_POLICY is read once while compiling/loading this configuration.
// Supply a trusted JSON document with issuer, audience, approved kids and jwks:
// {"issuer":"https://issuer.example","audience":"orders",
//  "kids":["current","previous"],"jwks":{"keys":[...public RSA JWKs...]}}.
// Optional policy controls: "revokedJtis":["compromised-id"], "issuedAfter":1700000000.
// revokedJtis requires a nonempty jti; issuedAfter requires iat strictly after it.
// Adopt replacement configuration to update revocation; old readers keep old policy.
// Optional remoteJwks config pins IPv4, TLS hostname, CA, path and cache deadlines;
// remote mode rejects until its first successful fetch. See docs/language-card.md.
// Keys must explicitly declare alg=RS256. Never populate policy from a request.
import "middleware/auth.rut"

route GET "/orders" {
    let identity = auth.jwtIdentityRs256(req.authorization.or(""), env("JWT_RS256_POLICY"),
                                       "orders:read", "orders-issuer-rs256")
    let userId = identity.consumerId
    return response(200, body: userId)
}
