import "clients/redis-client.rut"

func exampleGetValue(_ result: RedisGetResult) -> Bytes {
    match result { .value(data) => data _ => nil }
}
func exampleGetStatus(_ result: RedisGetResult) -> i32 {
    match result {
        .value(data) => 200
        .missing => 404
        .requestFailure => 413
        .transportFailure(code) => if code == -2 { 504 } else { 502 }
        _ => 502
    }
}
func exampleSetStatus(_ result: RedisSetResult) -> i32 {
    match result {
        .ok => 204
        .requestFailure => 413
        .transportFailure(code) => if code == -2 { 504 } else { 502 }
        _ => 502
    }
}
// Fixed TCP/TLS endpoint policy; add poolIdleMs (1...60000) for cross-request reuse.
// Plain GET/SET restore protocol state. Failed replies already close the handle.
route POST "/get" {
    let pendingOpen = tcp(env("REDIS_ENDPOINT"), 1000)
    guard let connection = pendingOpen else { return 503 }
    let result = redisGet(connection, req.bodyBytes)
    let closed = connection.release()
    let status = exampleGetStatus(result)
    guard status != 404 else { return 404 }
    guard status != 413 else { return 413 }
    guard status != 504 else { return 504 }
    guard let payload = exampleGetValue(result) else { return 502 }
    return response(200, body: payload)
}
route POST "/set" {
    let pendingOpen = tcp(env("REDIS_ENDPOINT"), 1000)
    guard let connection = pendingOpen else { return 503 }
    let result = redisSet(connection, b"example-key", req.bodyBytes)
    let closed = connection.release()
    let status = exampleSetStatus(result)
    guard status != 413 else { return 413 }
    guard status != 504 else { return 504 }
    guard status == 204 else { return 502 }
    return 204
}
