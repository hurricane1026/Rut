// Set API_KEY, CONSUMER_ID, JWT_ISSUER, JWT_AUDIENCE and JWT_ISSUE_KEY at load time.
// Serve behind TLS. The route authenticates its API key before issuing a token.
import Crypto
import "middleware/auth.rut"
listen :8080

route POST "/token" {
    let identity = auth.apiKey(
        req.authorization.or(""), env("API_KEY"), env("CONSUMER_ID"), "api-key")
    let requestId = uuid()
    guard let tokenId = requestId else { return response(503) }
    guard let token = auth.jwtForIdentityHs256WithId(
        identity, env("JWT_ISSUER"), env("JWT_AUDIENCE"), tokenId,
        env("JWT_ISSUE_KEY"), 900) else {
        return response(503)
    }
    return response(200, body: token)
}
