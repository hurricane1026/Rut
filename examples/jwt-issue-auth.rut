// Set API_KEY, CONSUMER_ID, JWT_ISSUER, JWT_AUDIENCE, JWT_ISSUE_SCOPE and
// JWT_ISSUE_KEY at load time. Scope is trusted configuration. Serve behind TLS.
// For multiple permissions set JWT_ISSUE_SCOPE="orders:read orders:write";
// only single spaces may separate tokens. Never copy requested scopes blindly.
import Crypto
import "middleware/auth.rut"
listen :8080

route POST "/token" {
    let identity = auth.apiKey(
        req.authorization.or(""), env("API_KEY"), env("CONSUMER_ID"), "api-key")
    let requestId = uuid()
    guard let tokenId = requestId else { return response(503) }
    guard let token = auth.jwtForIdentityHs256WithIdAndScope(
        identity, env("JWT_ISSUER"), env("JWT_AUDIENCE"), tokenId,
        env("JWT_ISSUE_SCOPE"), env("JWT_ISSUE_KEY"), 900) else {
        return response(503)
    }
    return response(200, body: token)
}
