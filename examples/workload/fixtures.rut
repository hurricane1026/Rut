// Synthetic benchmark origin: distinct URLs share one server.
listen 127.0.0.1:8704
route GET "/static4k" { return workload(bytes: 4096) }
route GET "/static256k" { return workload(bytes: 262144) }
route GET "/static1m" { return workload(bytes: 1048576) }
route GET "/api4k" {
    wait(1ms)
    return workload(bytes: 4096)
}
