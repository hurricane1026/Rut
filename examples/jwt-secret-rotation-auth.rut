import "middleware/auth.rut"

listen :8080

// Trusted compile-time secrets, never token-supplied keys. Use distinct,
// high-entropy current/previous keys of at least 32/48/64 bytes respectively.
// An empty previous secret revokes that slot; restart/reload the configuration.
// Compiled programs contain the resolved secrets; protect the artifacts.
route GET "/hs256" {
    let claims = auth.rotatingJwtDocumentHs256(req.authorization.or(""),
        env("HS256_CURRENT_SECRET"), env("HS256_PREVIOUS_SECRET"))
    let identity = auth.jwtIdentity(claims, "https://issuer.example", "orders", "hs256-policy")
    guard jwtHasScope(claims, "orders.read") else { return 403 }
    let subject = identity.consumerId
    return response(200, body: subject)
}

route GET "/hs384" {
    let claims = auth.rotatingJwtDocumentHs384(req.authorization.or(""),
        env("HS384_CURRENT_SECRET"), env("HS384_PREVIOUS_SECRET"))
    let identity = auth.jwtIdentity(claims, "https://issuer.example", "orders", "hs384-policy")
    guard jwtHasScope(claims, "orders.read") else { return 403 }
    let subject = identity.consumerId
    return response(200, body: subject)
}

route GET "/hs512" {
    let claims = auth.rotatingJwtDocumentHs512(req.authorization.or(""),
        env("HS512_CURRENT_SECRET"), env("HS512_PREVIOUS_SECRET"))
    let identity = auth.jwtIdentity(claims, "https://issuer.example", "orders", "hs512-policy")
    guard jwtHasScope(claims, "orders.read") else { return 403 }
    let subject = identity.consumerId
    return response(200, body: subject)
}

route "/" { return 404 }
