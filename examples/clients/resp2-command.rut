// Binary-safe command construction, using only generic bounded byte primitives.
struct Resp2Command {
    packet: Bytes
    expected: i32
    written: i32
    limit: i32
}
func resp2DecimalLine(_ prefix: Bytes, _ value: i32, _ limit: i32) {
    guard let digits = formatInt(value) else { nil }
    guard let start = concatBytes(prefix, Bytes(digits), limit) else { nil }
    concatBytes(start, b"\r\n", limit)
}
func resp2Command(_ argumentCount: i32, _ maxBytes: i32) {
    guard argumentCount > 0 && argumentCount < 64 && maxBytes > 0 && !(maxBytes > 8192) else { nil }
    guard let header = resp2DecimalLine(b"*", argumentCount, maxBytes) else { nil }
    Resp2Command(packet: header, expected: argumentCount, written: 0, limit: maxBytes)
}
func resp2BulkArgument(_ payload: Bytes, _ limit: i32) {
    guard let header = resp2DecimalLine(b"$", payload.count, limit) else { nil }
    guard let content = concatBytes(header, payload, limit) else { nil }
    concatBytes(content, b"\r\n", limit)
}
func resp2Argument(_ command: Resp2Command, _ payload: Bytes) {
    guard command.expected > 0 && command.expected < 64 && command.written > -1 &&
        command.written < command.expected && command.limit > 0 && !(command.limit > 8192) else { nil }
    guard let argument = resp2BulkArgument(payload, command.limit - command.packet.count) else { nil }
    guard let packet = concatBytes(command.packet, argument, command.limit) else { nil }
    Resp2Command(packet: packet, expected: command.expected, written: command.written + 1, limit: command.limit)
}
func resp2Request(_ command: Resp2Command) {
    guard command.expected > 0 && command.expected < 64 && command.written == command.expected &&
        command.limit > 0 && !(command.limit > 8192) && !(command.packet.count > command.limit) else { nil }
    command.packet
}
func resp2GetRequest(_ key: Bytes) {
    guard let initial = resp2Command(2, 8192) else { nil }
    guard let named = resp2Argument(initial, b"GET") else { nil }
    guard let keyed = resp2Argument(named, key) else { nil }
    resp2Request(keyed)
}
func resp2SetRequest(_ key: Bytes, _ value: Bytes) {
    guard let initial = resp2Command(3, 8192) else { nil }
    guard let named = resp2Argument(initial, b"SET") else { nil }
    guard let keyed = resp2Argument(named, key) else { nil }
    guard let valued = resp2Argument(keyed, value) else { nil }
    resp2Request(valued)
}

func resp2AuthRequest(_ password: Bytes) {
    guard let initial = resp2Command(2, 8192) else { nil }
    guard let named = resp2Argument(initial, b"AUTH") else { nil }
    guard let secret = resp2Argument(named, password) else { nil }
    resp2Request(secret)
}
func resp2AuthUserRequest(_ username: Bytes, _ password: Bytes) {
    guard let initial = resp2Command(3, 8192) else { nil }
    guard let named = resp2Argument(initial, b"AUTH") else { nil }
    guard let user = resp2Argument(named, username) else { nil }
    guard let secret = resp2Argument(user, password) else { nil }
    resp2Request(secret)
}
func resp2SelectRequest(_ database: i32) {
    guard database > -1 else { nil }
    guard let digits = formatInt(database) else { nil }
    guard let initial = resp2Command(2, 8192) else { nil }
    guard let named = resp2Argument(initial, b"SELECT") else { nil }
    guard let selected = resp2Argument(named, Bytes(digits)) else { nil }
    resp2Request(selected)
}
func resp2ResetRequest() -> Bytes { b"*1\r\n$5\r\nRESET\r\n" }

func resp2KeyRequest(_ name: Bytes, _ key: Bytes) {
    guard let argument = resp2BulkArgument(name, 8192) else { nil }
    guard let keyed = resp2BulkArgument(key, 8192) else { nil }
    guard let prefix = concatBytes(b"*2\r\n", argument, 8192) else { nil }
    concatBytes(prefix, keyed, 8192)
}
func resp2KeyNumberRequest(_ name: Bytes, _ key: Bytes, _ amount: i32) {
    guard let digits = formatInt(amount) else { nil }
    guard let named = resp2BulkArgument(name, 8192) else { nil }
    guard let keyed = resp2BulkArgument(key, 8192) else { nil }
    guard let numbered = resp2BulkArgument(Bytes(digits), 8192) else { nil }
    guard let pair = concatBytes(named, keyed, 8192) else { nil }
    guard let arguments = concatBytes(pair, numbered, 8192) else { nil }
    concatBytes(b"*3\r\n", arguments, 8192)
}
// Closed choices prevent contradictory conditions or expiration modes.
variant RedisSetCondition { always absent present }
variant RedisSetExpiry { none seconds(i32) milliseconds(i32) unixSeconds(Bytes) unixMilliseconds(Bytes) keepTtl }
func resp2SetCondition(_ condition: RedisSetCondition) -> Bytes {
    match condition {
        .always => b""
        .absent => b"$2\r\nNX\r\n"
        .present => b"$2\r\nXX\r\n"
    }
}
func resp2SetExpiryNumber(_ unit: Bytes, _ amount: i32) {
    guard amount > 0 else { nil }
    guard let digits = formatInt(amount) else { nil }
    guard let number = resp2BulkArgument(Bytes(digits), 8192) else { nil }
    concatBytes(unit, number, 8192)
}
// Decimal bytes retain timestamps beyond i32 without requiring a source i64 type.
func resp2SetAbsoluteExpiry(_ unit: Bytes, _ digits: Bytes, _ seconds: bool) {
    guard digits[0].or(0) > 47 && digits[0].or(0) < 58 else { nil }
    guard let amount = parseInt64(digits) else { nil }
    guard amount > 0 && (!seconds || amount < 9223372036854776) else { nil }
    guard let canonical = formatInt(amount) else { nil }
    guard let number = resp2BulkArgument(Bytes(canonical), 8192) else { nil }
    concatBytes(unit, number, 8192)
}
func resp2SetExpiry(_ expiry: RedisSetExpiry) {
    match expiry {
        .none => b""
        .seconds(amount) => resp2SetExpiryNumber(b"$2\r\nEX\r\n", amount)
        .milliseconds(amount) => resp2SetExpiryNumber(b"$2\r\nPX\r\n", amount)
        .unixSeconds(amount) => resp2SetAbsoluteExpiry(b"$4\r\nEXAT\r\n", amount, true)
        .unixMilliseconds(amount) => resp2SetAbsoluteExpiry(b"$4\r\nPXAT\r\n", amount, false)
        .keepTtl => b"$7\r\nKEEPTTL\r\n"
    }
}
func resp2SetArguments(_ key: Bytes, _ value: Bytes) {
    guard let keyed = resp2BulkArgument(key, 8192) else { nil }
    guard let valued = resp2BulkArgument(value, 8192) else { nil }
    guard let pair = concatBytes(keyed, valued, 8192) else { nil }
    concatBytes(b"$3\r\nSET\r\n", pair, 8192)
}
func resp2SetArgumentCount(_ conditional: Bytes, _ expiry: RedisSetExpiry) -> i32 {
    match expiry {
        .none => if conditional.count > 0 { 4 } else { 3 }
        .seconds(amount) => if conditional.count > 0 { 6 } else { 5 }
        .milliseconds(amount) => if conditional.count > 0 { 6 } else { 5 }
        .unixSeconds(amount) => if conditional.count > 0 { 6 } else { 5 }
        .unixMilliseconds(amount) => if conditional.count > 0 { 6 } else { 5 }
        .keepTtl => if conditional.count > 0 { 5 } else { 4 }
    }
}
func resp2SetOptionsRequest(_ key: Bytes, _ value: Bytes, _ condition: RedisSetCondition, _ expiry: RedisSetExpiry) {
    guard let arguments = resp2SetArguments(key, value) else { nil }
    let conditional = resp2SetCondition(condition)
    guard let expiration = resp2SetExpiry(expiry) else { nil }
    let count = resp2SetArgumentCount(conditional, expiry)
    guard let header = resp2DecimalLine(b"*", count, 8192) else { nil }
    guard let prefix = concatBytes(header, arguments, 8192) else { nil }
    guard let conditioned = concatBytes(prefix, conditional, 8192) else { nil }
    concatBytes(conditioned, expiration, 8192)
}
func resp2SetGetRequest(_ key: Bytes, _ value: Bytes, _ condition: RedisSetCondition, _ expiry: RedisSetExpiry) {
    guard let arguments = resp2SetArguments(key, value) else { nil }
    let conditional = resp2SetCondition(condition)
    guard let expiration = resp2SetExpiry(expiry) else { nil }
    guard let header = resp2DecimalLine(b"*", resp2SetArgumentCount(conditional, expiry) + 1, 8192) else { nil }
    guard let prefix = concatBytes(header, arguments, 8192) else { nil }
    guard let conditioned = concatBytes(prefix, conditional, 8192) else { nil }
    guard let expiring = concatBytes(conditioned, expiration, 8192) else { nil }
    concatBytes(expiring, b"$3\r\nGET\r\n", 8192)
}
