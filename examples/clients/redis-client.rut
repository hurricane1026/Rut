import "resp2-command.rut"
import "resp2.rut"

variant RedisGetResult {
    value(Bytes)
    missing
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
variant RedisSetResult {
    ok
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
// Scalar commands need at most one completed RESP2 node per feed. Sharing the
// generic step with a one-item budget avoids expanding the 64-node array path.
func redisScalarFeed(_ stream: Resp2Stream, _ chunk: Bytes) {
    guard stream.cursor.status == 0 else { nil }
    guard let bytes = concatBytes(stream.bytes, chunk, stream.cursor.limit) else { nil }
    guard let steps = collectBytes(bytes, stream.cursor, 1, resp2StreamStep) else { nil }
    guard let cursor = steps.get(0) else { nil }
    resp2StreamFinish(bytes, cursor)
}
func redisReceive(_ connection: TcpConnection, _ stream: Resp2Stream) {
    if stream.cursor.status == 0 {
        let pending = connection.receive(stream.cursor.limit - stream.bytes.count, 1000)
        guard let chunk = pending else { nil }
        guard chunk.count > 0 else { nil }
        redisScalarFeed(stream, chunk)
    } else { stream }
}
// Four receives are the explicit reply-read budget. Each uses a 1000 ms
// operation deadline. These helpers never resend a command; failures poison the handle below.
func redisReadTwice(_ connection: TcpConnection, _ initial: Resp2Stream) {
    let pendingFirst = redisReceive(connection, initial)
    guard let first = pendingFirst else { nil }
    let pendingSecond = redisReceive(connection, first)
    guard let second = pendingSecond else { nil }
    second
}
func redisReadFour(_ connection: TcpConnection, _ initial: Resp2Stream) {
    let pendingFirst = redisReadTwice(connection, initial)
    guard let first = pendingFirst else { nil }
    let pendingSecond = redisReadTwice(connection, first)
    guard let second = pendingSecond else { nil }
    second
}
// GET and plain SET have scalar replies. Bound token decoding to one item;
// a nested aggregate, trailing reply or incomplete frame fails closed.
func redisScalarReply(_ stream: Resp2Stream) {
    guard resp2Finished(stream) else { nil }
    guard let values = collectBytes(stream.bytes, Resp2State(offset: 0, pending: 1), 1, resp2Step) else { nil }
    guard let root = values.get(0) else { nil }
    guard root.next == stream.bytes.count else { nil }
    root
}
func redisReply(_ connection: TcpConnection) {
    guard let initial = resp2Stream(8192) else { nil }
    let pending = redisReadFour(connection, initial)
    guard let stream = pending else { nil }
    redisScalarReply(stream)
}
func redisGetReadFailure(_ code: i32) -> RedisGetResult {
    if code == 0 { RedisGetResult.replyFailure } else { RedisGetResult.transportFailure(code) }
}
func redisSetReadFailure(_ code: i32) -> RedisSetResult {
    if code == 0 { RedisSetResult.replyFailure } else { RedisSetResult.transportFailure(code) }
}
func redisGetMustClose(_ result: RedisGetResult) -> bool {
    match result {
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func redisSetMustClose(_ result: RedisSetResult) -> bool {
    match result {
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func redisGetFinish(_ connection: TcpConnection, _ result: RedisGetResult) -> RedisGetResult {
    if redisGetMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}
func redisSetFinish(_ connection: TcpConnection, _ result: RedisSetResult) -> RedisSetResult {
    if redisSetMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}
func redisGetExecute(_ connection: TcpConnection, _ key: Bytes) {
    guard let request = resp2GetRequest(key) else { RedisGetResult.requestFailure }
    let pendingSend = connection.send(request, 1000)
    guard let sent = pendingSend else { RedisGetResult.transportFailure(netError()) }
    let pendingRead = redisReply(connection)
    guard let reply = pendingRead else { redisGetReadFailure(netError()) }
    if reply.kind == 4 {
        RedisGetResult.value(reply.data)
    } else {
        if reply.kind == 6 {
            RedisGetResult.missing
        } else {
            guard reply.kind == 2 else { RedisGetResult.replyFailure }
            RedisGetResult.serverError(reply.data)
        }
    }
}
func redisSetExecute(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes) {
    guard let request = resp2SetRequest(key, value) else { RedisSetResult.requestFailure }
    let pendingSend = connection.send(request, 1000)
    guard let sent = pendingSend else { RedisSetResult.transportFailure(netError()) }
    let pendingRead = redisReply(connection)
    guard let reply = pendingRead else { redisSetReadFailure(netError()) }
    if reply.kind == 1 && reply.data == b"OK" {
        RedisSetResult.ok
    } else {
        guard reply.kind == 2 else { RedisSetResult.replyFailure }
        RedisSetResult.serverError(reply.data)
    }
}

func redisGet(_ connection: TcpConnection, _ key: Bytes) -> RedisGetResult {
    let result = redisGetExecute(connection, key)
    redisGetFinish(connection, result)
}
func redisSet(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes) -> RedisSetResult {
    let result = redisSetExecute(connection, key, value)
    redisSetFinish(connection, result)
}

// Connection-changing commands close on every failure. They cannot leave a
// prior identity/database available for accidental reuse after a failed change.
variant RedisCommandResult {
    ok
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
variant RedisInitializeResult {
    ready
    authError(Bytes)
    databaseError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
variant RedisSessionResult {
    value(Bytes)
    missing
    ok
    authError(Bytes)
    databaseError(Bytes)
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
    resetError(Bytes)
    cleanupFailure(i32)
}
func redisCommandSucceeded(_ result: RedisCommandResult) -> bool {
    match result { .ok => true _ => false }
}
func redisCommandReadFailure(_ code: i32) -> RedisCommandResult {
    if code == 0 { RedisCommandResult.replyFailure } else { RedisCommandResult.transportFailure(code) }
}
// Status replies use two receives. This leaves room for initialization, one
// business command and acknowledged RESET + release under the 16-op profile.
func redisCommandWire(_ connection: TcpConnection, _ request: Bytes, _ expected: Bytes) {
    let sending = connection.send(request, 1000)
    guard let sent = sending else { RedisCommandResult.transportFailure(netError()) }
    guard let initial = resp2Stream(8192) else { RedisCommandResult.replyFailure }
    let reading = redisReadTwice(connection, initial)
    guard let stream = reading else { redisCommandReadFailure(netError()) }
    guard let reply = redisScalarReply(stream) else { RedisCommandResult.replyFailure }
    if reply.kind == 1 && reply.data == expected {
        RedisCommandResult.ok
    } else {
        guard reply.kind == 2 else { RedisCommandResult.replyFailure }
        RedisCommandResult.serverError(reply.data)
    }
}
func redisCommandFinish(_ connection: TcpConnection, _ result: RedisCommandResult) -> RedisCommandResult {
    if redisCommandSucceeded(result) { result } else {
        let closed = connection.close()
        result
    }
}
func redisAuthExecute(_ connection: TcpConnection, _ password: Bytes) {
    guard let request = resp2AuthRequest(password) else { RedisCommandResult.requestFailure }
    redisCommandWire(connection, request, b"OK")
}
func redisAuth(_ connection: TcpConnection, _ password: Bytes) -> RedisCommandResult {
    let result = redisAuthExecute(connection, password)
    redisCommandFinish(connection, result)
}
func redisAuthUserExecute(_ connection: TcpConnection, _ username: Bytes, _ password: Bytes) {
    guard let request = resp2AuthUserRequest(username, password) else { RedisCommandResult.requestFailure }
    redisCommandWire(connection, request, b"OK")
}
func redisAuthUser(_ connection: TcpConnection, _ username: Bytes, _ password: Bytes) -> RedisCommandResult {
    let result = redisAuthUserExecute(connection, username, password)
    redisCommandFinish(connection, result)
}
func redisSelectExecute(_ connection: TcpConnection, _ database: i32) {
    guard let request = resp2SelectRequest(database) else { RedisCommandResult.requestFailure }
    redisCommandWire(connection, request, b"OK")
}
func redisSelect(_ connection: TcpConnection, _ database: i32) -> RedisCommandResult {
    let result = redisSelectExecute(connection, database)
    redisCommandFinish(connection, result)
}
func redisReset(_ connection: TcpConnection) -> RedisCommandResult {
    let result = redisCommandWire(connection, resp2ResetRequest(), b"RESET")
    redisCommandFinish(connection, result)
}
func redisInitializeSucceeded(_ result: RedisInitializeResult) -> bool {
    match result { .ready => true _ => false }
}
func redisInitializeReadFailure(_ code: i32) -> RedisInitializeResult {
    if code == 0 { RedisInitializeResult.replyFailure } else { RedisInitializeResult.transportFailure(code) }
}
func redisInitializeStream() -> Resp2Stream {
    Resp2Stream(bytes: b"", cursor: Resp2Cursor(offset: 0, pending: 2, nodes: 0,
        status: 0, search: 1, bulkEnd: -1, limit: 8192))
}
func redisInitializeFeed(_ stream: Resp2Stream, _ chunk: Bytes) {
    guard let bytes = concatBytes(stream.bytes, chunk, stream.cursor.limit) else { nil }
    guard let steps = collectBytes(bytes, stream.cursor, 2, resp2StreamStep) else { nil }
    guard let cursor = steps.get(steps.count - 1) else { nil }
    resp2StreamFinish(bytes, cursor)
}
func redisInitializeReceive(_ connection: TcpConnection, _ stream: Resp2Stream) {
    if stream.cursor.status == 0 {
        let pending = connection.receive(stream.cursor.limit - stream.bytes.count, 1000)
        guard let chunk = pending else { nil }
        guard chunk.count > 0 else { nil }
        redisInitializeFeed(stream, chunk)
    } else { stream }
}
func redisInitializeRead(_ connection: TcpConnection) {
    let firstRead = redisInitializeReceive(connection, redisInitializeStream())
    guard let first = firstRead else { nil }
    let secondRead = redisInitializeReceive(connection, first)
    guard let second = secondRead else { nil }
    second
}
func redisInitializeValidate(_ stream: Resp2Stream) {
    guard resp2Finished(stream) else { RedisInitializeResult.replyFailure }
    guard let replies = collectBytes(stream.bytes, Resp2State(offset: 0, pending: 2), 2, resp2Step) else {
        RedisInitializeResult.replyFailure
    }
    guard let auth = replies.get(0) else { RedisInitializeResult.replyFailure }
    guard let selected = replies.get(1) else { RedisInitializeResult.replyFailure }
    guard selected.next == stream.bytes.count else { RedisInitializeResult.replyFailure }
    if auth.kind == 2 { RedisInitializeResult.authError(auth.data) } else {
        guard auth.kind == 1 && auth.data == b"OK" else { RedisInitializeResult.replyFailure }
        if selected.kind == 2 { RedisInitializeResult.databaseError(selected.data) } else {
            guard selected.kind == 1 && selected.data == b"OK" else { RedisInitializeResult.replyFailure }
            RedisInitializeResult.ready
        }
    }
}
// Only AUTH and SELECT are pipelined. A business command is never sent until
// both replies have been consumed, validated and acknowledged with exact +OK.
func redisInitializeWire(_ connection: TcpConnection, _ request: Bytes) {
    let sending = connection.send(request, 1000)
    guard let sent = sending else { RedisInitializeResult.transportFailure(netError()) }
    let reading = redisInitializeRead(connection)
    guard let stream = reading else { redisInitializeReadFailure(netError()) }
    redisInitializeValidate(stream)
}
func redisInitializeExecute(_ connection: TcpConnection, _ username: Bytes, _ password: Bytes, _ database: i32) {
    guard let auth = resp2AuthUserRequest(username, password) else { RedisInitializeResult.requestFailure }
    guard let select = resp2SelectRequest(database) else { RedisInitializeResult.requestFailure }
    guard let request = concatBytes(auth, select, 8192) else { RedisInitializeResult.requestFailure }
    redisInitializeWire(connection, request)
}
func redisInitializeDefaultExecute(_ connection: TcpConnection, _ password: Bytes, _ database: i32) {
    guard let auth = resp2AuthRequest(password) else { RedisInitializeResult.requestFailure }
    guard let select = resp2SelectRequest(database) else { RedisInitializeResult.requestFailure }
    guard let request = concatBytes(auth, select, 8192) else { RedisInitializeResult.requestFailure }
    redisInitializeWire(connection, request)
}
func redisInitializeFinish(_ connection: TcpConnection, _ result: RedisInitializeResult) -> RedisInitializeResult {
    if redisInitializeSucceeded(result) { result } else {
        let closed = connection.close()
        result
    }
}
func redisInitialize(_ connection: TcpConnection, _ username: Bytes, _ password: Bytes, _ database: i32) -> RedisInitializeResult {
    let result = redisInitializeExecute(connection, username, password, database)
    redisInitializeFinish(connection, result)
}
func redisInitializeDefault(_ connection: TcpConnection, _ password: Bytes, _ database: i32) -> RedisInitializeResult {
    let result = redisInitializeDefaultExecute(connection, password, database)
    redisInitializeFinish(connection, result)
}
func redisSessionFromInitialize(_ result: RedisInitializeResult) -> RedisSessionResult {
    match result {
        .ready => RedisSessionResult.ok
        .authError(data) => RedisSessionResult.authError(data)
        .databaseError(data) => RedisSessionResult.databaseError(data)
        .requestFailure => RedisSessionResult.requestFailure
        .transportFailure(code) => RedisSessionResult.transportFailure(code)
        .replyFailure => RedisSessionResult.replyFailure
    }
}
func redisSessionFromGet(_ result: RedisGetResult) -> RedisSessionResult {
    match result {
        .value(data) => RedisSessionResult.value(data)
        .missing => RedisSessionResult.missing
        .serverError(data) => RedisSessionResult.serverError(data)
        .requestFailure => RedisSessionResult.requestFailure
        .transportFailure(code) => RedisSessionResult.transportFailure(code)
        .replyFailure => RedisSessionResult.replyFailure
    }
}
func redisSessionFromSet(_ result: RedisSetResult) -> RedisSessionResult {
    match result {
        .ok => RedisSessionResult.ok
        .serverError(data) => RedisSessionResult.serverError(data)
        .requestFailure => RedisSessionResult.requestFailure
        .transportFailure(code) => RedisSessionResult.transportFailure(code)
        .replyFailure => RedisSessionResult.replyFailure
    }
}
func redisSessionAlreadyClosed(_ result: RedisSessionResult) -> bool {
    match result {
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func redisSessionAfterReset(_ connection: TcpConnection, _ reset: RedisCommandResult, _ result: RedisSessionResult) -> RedisSessionResult {
    match reset {
        .ok => {
            let returned = connection.release()
            let code = netError()
            if code == 0 { result } else { RedisSessionResult.cleanupFailure(code) }
        }
        .serverError(data) => RedisSessionResult.resetError(data)
        .transportFailure(code) => RedisSessionResult.cleanupFailure(code)
        _ => RedisSessionResult.cleanupFailure(0)
    }
}
func redisSessionFinish(_ connection: TcpConnection, _ result: RedisSessionResult) -> RedisSessionResult {
    if redisSessionAlreadyClosed(result) { result } else {
        let reset = redisReset(connection)
        redisSessionAfterReset(connection, reset, result)
    }
}
// Each operation initializes its own identity/database and resets before return.
// Together with tcp(), these helpers fit the existing sixteen-I/O profile.
func redisSessionGet(_ connection: TcpConnection, _ username: Bytes, _ password: Bytes, _ database: i32, _ key: Bytes) -> RedisSessionResult {
    let initialized = redisInitialize(connection, username, password, database)
    guard redisInitializeSucceeded(initialized) else { redisSessionFromInitialize(initialized) }
    let reply = redisGet(connection, key)
    redisSessionFinish(connection, redisSessionFromGet(reply))
}
func redisSessionSet(_ connection: TcpConnection, _ username: Bytes, _ password: Bytes, _ database: i32, _ key: Bytes, _ value: Bytes) -> RedisSessionResult {
    let initialized = redisInitialize(connection, username, password, database)
    guard redisInitializeSucceeded(initialized) else { redisSessionFromInitialize(initialized) }
    let reply = redisSet(connection, key, value)
    redisSessionFinish(connection, redisSessionFromSet(reply))
}

// General replies retain an invocation-owned frame and a typed root. Arrays
// use decodeResp2's bounded preorder representation; no collection is hidden
// in a record, and integer access never narrows the wire's signed 64-bit value.
struct RedisReply { frame: Bytes root: Resp2Token }
variant RedisResult {
    reply(RedisReply)
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
func redisValues(_ reply: RedisReply) { decodeResp2(reply.frame) }
func redisInteger(_ reply: RedisReply) { resp2Integer(reply.root) }
func redisBulk(_ reply: RedisReply) {
    guard reply.root.kind == 4 else { nil }
    reply.root.data
}
func redisReadValuesTwice(_ connection: TcpConnection, _ stream: Resp2Stream) {
    let readingFirst = resp2Receive(connection, stream)
    guard let first = readingFirst else { nil }
    let readingSecond = resp2Receive(connection, first)
    guard let second = readingSecond else { nil }
    second
}
func redisReadValues(_ connection: TcpConnection) {
    guard let initial = resp2Stream(8192) else { nil }
    let readingFirst = redisReadValuesTwice(connection, initial)
    guard let first = readingFirst else { nil }
    let readingSecond = redisReadValuesTwice(connection, first)
    guard let stream = readingSecond else { nil }
    guard resp2Finished(stream) else { nil }
    stream.bytes
}
func redisResultReadFailure(_ code: i32) -> RedisResult {
    if code == 0 { RedisResult.replyFailure } else { RedisResult.transportFailure(code) }
}
func redisDecodeReply(_ frame: Bytes) -> RedisResult {
    guard let values = decodeResp2(frame) else { RedisResult.replyFailure }
    guard let root = values.get(0) else { RedisResult.replyFailure }
    if root.kind == 2 { RedisResult.serverError(root.data) } else {
        RedisResult.reply(RedisReply(frame: frame, root: root))
    }
}
func redisExecuteWire(_ connection: TcpConnection, _ request: Bytes) -> RedisResult {
    guard redisRequestValid(request) else { RedisResult.requestFailure }
    let sending = connection.send(request, 1000)
    guard let sent = sending else { RedisResult.transportFailure(netError()) }
    let reading = redisReadValues(connection)
    guard let frame = reading else { redisResultReadFailure(netError()) }
    redisDecodeReply(frame)
}
// Commands whose contract is scalar use the one-node incremental path. This
// keeps ordinary key operations cheap without reducing general reply bounds.
func redisScalarResult(_ stream: Resp2Stream) -> RedisResult {
    guard let root = redisScalarReply(stream) else { RedisResult.replyFailure }
    if root.kind == 2 { RedisResult.serverError(root.data) } else {
        RedisResult.reply(RedisReply(frame: stream.bytes, root: root))
    }
}
func redisExecuteScalarWire(_ connection: TcpConnection, _ request: Bytes) -> RedisResult {
    guard redisRequestValid(request) else { RedisResult.requestFailure }
    let sending = connection.send(request, 1000)
    guard let sent = sending else { RedisResult.transportFailure(netError()) }
    guard let initial = resp2Stream(8192) else { RedisResult.replyFailure }
    let reading = redisReadFour(connection, initial)
    guard let stream = reading else { redisResultReadFailure(netError()) }
    redisScalarResult(stream)
}
func redisResultMustClose(_ result: RedisResult) -> bool {
    match result {
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func redisResultFinish(_ connection: TcpConnection, _ result: RedisResult) -> RedisResult {
    if redisResultMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}
// Exactly one command and one RESP2 value, with four bounded receives and no
// retry. Stateful commands require caller-managed cleanup before pool return.
func redisExecute(_ connection: TcpConnection, _ request: Bytes) -> RedisResult {
    let result = redisExecuteWire(connection, request)
    redisResultFinish(connection, result)
}
// Integer conveniences validate the expected reply before returning it. TTL
// sentinels and counter values remain signed 64-bit through redisInteger().
func redisExpectInteger(_ result: RedisResult) -> RedisResult {
    match result {
        .reply(value) => if value.root.kind == 3 { result } else { RedisResult.replyFailure }
        _ => result
    }
}
func redisIntegerCommand(_ connection: TcpConnection, _ request: Bytes) -> RedisResult {
    let result = redisExecuteScalarWire(connection, request)
    redisResultFinish(connection, redisExpectInteger(result))
}
func redisDel(_ connection: TcpConnection, _ key: Bytes) -> RedisResult {
    guard let request = resp2KeyRequest(b"DEL", key) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
func redisExists(_ connection: TcpConnection, _ key: Bytes) -> RedisResult {
    guard let request = resp2KeyRequest(b"EXISTS", key) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
func redisTtl(_ connection: TcpConnection, _ key: Bytes) -> RedisResult {
    guard let request = resp2KeyRequest(b"TTL", key) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
func redisPttl(_ connection: TcpConnection, _ key: Bytes) -> RedisResult {
    guard let request = resp2KeyRequest(b"PTTL", key) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
func redisIncr(_ connection: TcpConnection, _ key: Bytes) -> RedisResult {
    guard let request = resp2KeyRequest(b"INCR", key) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
func redisDecr(_ connection: TcpConnection, _ key: Bytes) -> RedisResult {
    guard let request = resp2KeyRequest(b"DECR", key) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
func redisExpire(_ connection: TcpConnection, _ key: Bytes, _ seconds: i32) -> RedisResult {
    guard let request = resp2KeyNumberRequest(b"EXPIRE", key, seconds) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
func redisPexpire(_ connection: TcpConnection, _ key: Bytes, _ milliseconds: i32) -> RedisResult {
    guard let request = resp2KeyNumberRequest(b"PEXPIRE", key, milliseconds) else { RedisResult.requestFailure }
    redisIntegerCommand(connection, request)
}
variant RedisSetOptionsResult {
    ok
    notSet
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
func redisSetOptionsReply(_ value: RedisReply, _ condition: RedisSetCondition) -> RedisSetOptionsResult {
    if value.root.kind == 6 {
        let conditional = resp2SetCondition(condition)
        guard conditional.count > 0 else { RedisSetOptionsResult.replyFailure }
        RedisSetOptionsResult.notSet
    } else {
        guard value.root.kind == 1 && value.root.data == b"OK" else { RedisSetOptionsResult.replyFailure }
        RedisSetOptionsResult.ok
    }
}
func redisSetOptionsResult(_ result: RedisResult, _ condition: RedisSetCondition) -> RedisSetOptionsResult {
    match result {
        .reply(value) => redisSetOptionsReply(value, condition)
        .serverError(data) => RedisSetOptionsResult.serverError(data)
        .requestFailure => RedisSetOptionsResult.requestFailure
        .transportFailure(code) => RedisSetOptionsResult.transportFailure(code)
        .replyFailure => RedisSetOptionsResult.replyFailure
    }
}
func redisSetOptionsMustClose(_ result: RedisSetOptionsResult) -> bool {
    match result {
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func redisSetWithOptions(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ condition: RedisSetCondition, _ expiry: RedisSetExpiry) -> RedisSetOptionsResult {
    guard let request = resp2SetOptionsRequest(key, value, condition, expiry) else { RedisSetOptionsResult.requestFailure }
    let result = redisExecuteScalarWire(connection, request)
    let typed = redisSetOptionsResult(result, condition)
    if redisSetOptionsMustClose(typed) {
        let closed = connection.close()
        typed
    } else { typed }
}

// GET returns the previous value even when NX rejects a write. A null bulk
// means no previous value, including a successful create or rejected XX.
struct RedisSetPrevious { found: bool data: Bytes }
variant RedisSetGetResult {
    stored(RedisSetPrevious)
    notStored(RedisSetPrevious)
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
func redisSetGetReply(_ connection: TcpConnection, _ reply: RedisReply, _ condition: RedisSetCondition) -> RedisSetGetResult {
    if reply.root.kind == 4 || reply.root.kind == 6 {
        let found = reply.root.kind == 4
        let data = reply.root.data
        let previous = RedisSetPrevious(found: found, data: data)
        match condition {
            .always => RedisSetGetResult.stored(previous)
            .absent => if found { RedisSetGetResult.notStored(previous) } else { RedisSetGetResult.stored(previous) }
            .present => if found { RedisSetGetResult.stored(previous) } else { RedisSetGetResult.notStored(previous) }
        }
    } else {
        let closed = connection.close()
        RedisSetGetResult.replyFailure
    }
}
func redisSetGet(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ condition: RedisSetCondition, _ expiry: RedisSetExpiry) -> RedisSetGetResult {
    guard let request = resp2SetGetRequest(key, value, condition, expiry) else { RedisSetGetResult.requestFailure }
    let result = redisExecuteScalarWire(connection, request)
    let finished = redisResultFinish(connection, result)
    match finished {
        .reply(reply) => redisSetGetReply(connection, reply, condition)
        .serverError(data) => RedisSetGetResult.serverError(data)
        .requestFailure => RedisSetGetResult.requestFailure
        .transportFailure(code) => RedisSetGetResult.transportFailure(code)
        .replyFailure => RedisSetGetResult.replyFailure
    }
}
