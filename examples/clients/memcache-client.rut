import "memcache-codec.rut"

variant MemcacheGetResult {
    value(MemcacheItem)
    missing
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
variant MemcacheStoreResult {
    stored
    notStored
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
variant MemcacheCommandResult {
    ok
    missing
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
variant MemcacheWireResult {
    reply(MemcacheReply)
    transportFailure(i32)
    replyFailure
}

// Four receives, each with its own fixed 1000 ms operation deadline. There is
// no retry, resend, quiet/noreply operation or implicit pool return.
func memcacheReceive(_ connection: TcpConnection, _ stream: MemcacheStream, _ key: Bytes) {
    if stream.reply.kind == 0 {
        let pending = connection.receive(8192 - stream.bytes.count, 1000)
        guard let chunk = pending else { nil }
        guard chunk.count > 0 else { nil }
        memcacheFeed(stream, chunk, key)
    } else { stream }
}
func memcacheReadTwice(_ connection: TcpConnection, _ stream: MemcacheStream, _ key: Bytes) {
    let pendingFirst = memcacheReceive(connection, stream, key)
    guard let first = pendingFirst else { nil }
    let pendingSecond = memcacheReceive(connection, first, key)
    guard let second = pendingSecond else { nil }
    second
}
func memcacheRead(_ connection: TcpConnection, _ key: Bytes) {
    let initial = MemcacheStream(bytes: b"", reply: memcacheEmptyReply(0))
    let pendingFirst = memcacheReadTwice(connection, initial, key)
    guard let first = pendingFirst else { nil }
    let pendingSecond = memcacheReadTwice(connection, first, key)
    guard let second = pendingSecond else { nil }
    guard second.reply.kind > 0 else { nil }
    second.reply
}
func memcacheReadFailure(_ code: i32) -> MemcacheWireResult {
    if code == 0 { MemcacheWireResult.replyFailure } else { MemcacheWireResult.transportFailure(code) }
}
func memcacheWire(_ connection: TcpConnection, _ request: Bytes, _ key: Bytes) -> MemcacheWireResult {
    let pendingSend = connection.send(request, 1000)
    guard let sent = pendingSend else { MemcacheWireResult.transportFailure(netError()) }
    let pendingRead = memcacheRead(connection, key)
    guard let reply = pendingRead else { memcacheReadFailure(netError()) }
    MemcacheWireResult.reply(reply)
}

func memcacheGetReply(_ reply: MemcacheReply) -> MemcacheGetResult {
    match reply.kind {
        1 => MemcacheGetResult.value(MemcacheItem(data: reply.data, flags: reply.flags))
        2 => MemcacheGetResult.missing
        8 => MemcacheGetResult.serverError(reply.data)
        _ => MemcacheGetResult.replyFailure
    }
}
func memcacheGetExecute(_ connection: TcpConnection, _ key: Bytes) -> MemcacheGetResult {
    guard let request = memcacheGetRequest(key) else { MemcacheGetResult.requestFailure }
    let result = memcacheWire(connection, request, key)
    match result {
        .reply(reply) => memcacheGetReply(reply)
        .transportFailure(code) => MemcacheGetResult.transportFailure(code)
        .replyFailure => MemcacheGetResult.replyFailure
    }
}
func memcacheGetMustClose(_ result: MemcacheGetResult) -> bool {
    match result {
        .serverError(data) => true
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func memcacheGet(_ connection: TcpConnection, _ key: Bytes) -> MemcacheGetResult {
    let result = memcacheGetExecute(connection, key)
    if memcacheGetMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}

func memcacheStoreReply(_ reply: MemcacheReply) -> MemcacheStoreResult {
    match reply.kind {
        3 => MemcacheStoreResult.stored
        4 => MemcacheStoreResult.notStored
        8 => MemcacheStoreResult.serverError(reply.data)
        _ => MemcacheStoreResult.replyFailure
    }
}

func memcacheStoreExpiryExecute(_ connection: TcpConnection, _ mode: MemcacheStoreMode,
    _ key: Bytes, _ value: Bytes, _ flags: Bytes, _ expiry: MemcacheExpiry) -> MemcacheStoreResult {
    guard let request = memcacheStoreExpiryRequest(mode, key, value, flags, expiry) else { MemcacheStoreResult.requestFailure }
    let result = memcacheWire(connection, request, key)
    match result {
        .reply(reply) => memcacheStoreReply(reply)
        .transportFailure(code) => MemcacheStoreResult.transportFailure(code)
        .replyFailure => MemcacheStoreResult.replyFailure
    }
}
func memcacheStoreExecute(_ connection: TcpConnection, _ mode: MemcacheStoreMode,
    _ key: Bytes, _ value: Bytes, _ settings: MemcacheOptions) -> MemcacheStoreResult {
    memcacheStoreExpiryExecute(connection, mode, key, value, settings.flags, MemcacheExpiry.seconds(settings.expirySeconds))
}

func memcacheStoreMustClose(_ result: MemcacheStoreResult) -> bool {
    match result {
        .serverError(data) => true
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func memcacheStore(_ connection: TcpConnection, _ mode: MemcacheStoreMode,
    _ key: Bytes, _ value: Bytes, _ settings: MemcacheOptions) -> MemcacheStoreResult {
    let result = memcacheStoreExecute(connection, mode, key, value, settings)
    if memcacheStoreMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}
func memcacheSet(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ settings: MemcacheOptions) -> MemcacheStoreResult {
    memcacheStore(connection, MemcacheStoreMode.set, key, value, settings)
}
func memcacheAdd(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ settings: MemcacheOptions) -> MemcacheStoreResult {
    memcacheStore(connection, MemcacheStoreMode.add, key, value, settings)
}
func memcacheReplace(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ settings: MemcacheOptions) -> MemcacheStoreResult {
    memcacheStore(connection, MemcacheStoreMode.replace, key, value, settings)
}

func memcacheCommandReply(_ reply: MemcacheReply, _ expected: i32) -> MemcacheCommandResult {
    if reply.kind == expected { MemcacheCommandResult.ok } else {
        match reply.kind {
            6 => MemcacheCommandResult.missing
            8 => MemcacheCommandResult.serverError(reply.data)
            _ => MemcacheCommandResult.replyFailure
        }
    }
}
func memcacheCommandWire(_ connection: TcpConnection, _ request: Bytes, _ key: Bytes, _ expected: i32) -> MemcacheCommandResult {
    let result = memcacheWire(connection, request, key)
    match result {
        .reply(reply) => memcacheCommandReply(reply, expected)
        .transportFailure(code) => MemcacheCommandResult.transportFailure(code)
        .replyFailure => MemcacheCommandResult.replyFailure
    }
}
func memcacheCommandMustClose(_ result: MemcacheCommandResult) -> bool {
    match result {
        .serverError(data) => true
        .transportFailure(code) => true
        .replyFailure => true
        _ => false
    }
}
func memcacheCommandFinish(_ connection: TcpConnection, _ result: MemcacheCommandResult) -> MemcacheCommandResult {
    if memcacheCommandMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}
func memcacheDeleteExecute(_ connection: TcpConnection, _ key: Bytes) -> MemcacheCommandResult {
    guard let request = memcacheDeleteRequest(key) else { MemcacheCommandResult.requestFailure }
    memcacheCommandWire(connection, request, key, 5)
}
func memcacheDelete(_ connection: TcpConnection, _ key: Bytes) -> MemcacheCommandResult {
    let result = memcacheDeleteExecute(connection, key)
    memcacheCommandFinish(connection, result)
}
func memcacheTouchExecute(_ connection: TcpConnection, _ key: Bytes, _ seconds: i32) -> MemcacheCommandResult {
    guard let request = memcacheTouchRequest(key, seconds) else { MemcacheCommandResult.requestFailure }
    memcacheCommandWire(connection, request, key, 7)
}
func memcacheTouch(_ connection: TcpConnection, _ key: Bytes, _ seconds: i32) -> MemcacheCommandResult {
    let result = memcacheTouchExecute(connection, key, seconds)
    memcacheCommandFinish(connection, result)
}

// append/prepend preserve the existing item's flags and expiration.
func memcacheConcatExecute(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ front: bool) -> MemcacheStoreResult {
    guard let request = memcacheConcatRequest(key, value, front) else { MemcacheStoreResult.requestFailure }
    let result = memcacheWire(connection, request, key)
    match result {
        .reply(reply) => memcacheStoreReply(reply)
        .transportFailure(code) => MemcacheStoreResult.transportFailure(code)
        .replyFailure => MemcacheStoreResult.replyFailure
    }
}
func memcacheConcat(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ front: bool) -> MemcacheStoreResult {
    let result = memcacheConcatExecute(connection, key, value, front)
    if memcacheStoreMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}
func memcacheAppend(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes) -> MemcacheStoreResult {
    memcacheConcat(connection, key, value, false)
}
func memcachePrepend(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes) -> MemcacheStoreResult {
    memcacheConcat(connection, key, value, true)
}
variant MemcacheCounterResult {
    value(Bytes)
    missing
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
func memcacheCounterReply(_ reply: MemcacheReply) -> MemcacheCounterResult {
    match reply.kind {
        10 => MemcacheCounterResult.value(reply.data)
        6 => MemcacheCounterResult.missing
        8 => MemcacheCounterResult.serverError(reply.data)
        _ => MemcacheCounterResult.replyFailure
    }
}
func memcacheCounterExecute(_ connection: TcpConnection, _ key: Bytes, _ amount: Bytes, _ decrement: bool) -> MemcacheCounterResult {
    guard let request = memcacheCounterRequest(key, amount, decrement) else { MemcacheCounterResult.requestFailure }
    let result = memcacheWire(connection, request, key)
    match result {
        .reply(reply) => memcacheCounterReply(reply)
        .transportFailure(code) => MemcacheCounterResult.transportFailure(code)
        .replyFailure => MemcacheCounterResult.replyFailure
    }
}
func memcacheCounter(_ connection: TcpConnection, _ key: Bytes, _ amount: Bytes, _ decrement: bool) -> MemcacheCounterResult {
    let result = memcacheCounterExecute(connection, key, amount, decrement)
    match result {
        .value(number) => result
        .missing => result
        .requestFailure => result
        _ => {
            let closed = connection.close()
            result
        }
    }
}
func memcacheIncrement(_ connection: TcpConnection, _ key: Bytes, _ amount: Bytes) -> MemcacheCounterResult {
    memcacheCounter(connection, key, amount, false)
}
func memcacheDecrement(_ connection: TcpConnection, _ key: Bytes, _ amount: Bytes) -> MemcacheCounterResult {
    memcacheCounter(connection, key, amount, true)
}
variant MemcacheCasResult {
    stored
    exists
    missing
    notStored
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
func memcacheCasReply(_ reply: MemcacheReply) -> MemcacheCasResult {
    match reply.kind {
        3 => MemcacheCasResult.stored
        9 => MemcacheCasResult.exists
        6 => MemcacheCasResult.missing
        4 => MemcacheCasResult.notStored
        8 => MemcacheCasResult.serverError(reply.data)
        _ => MemcacheCasResult.replyFailure
    }
}

func memcacheCasExpiryExecute(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ flags: Bytes,
    _ expiry: MemcacheExpiry, _ cas: Bytes) -> MemcacheCasResult {
    guard let request = memcacheCasExpiryRequest(key, value, flags, expiry, cas) else { MemcacheCasResult.requestFailure }
    let result = memcacheWire(connection, request, key)
    match result {
        .reply(reply) => memcacheCasReply(reply)
        .transportFailure(code) => MemcacheCasResult.transportFailure(code)
        .replyFailure => MemcacheCasResult.replyFailure
    }
}
func memcacheCasExecute(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ settings: MemcacheOptions, _ cas: Bytes) -> MemcacheCasResult {
    memcacheCasExpiryExecute(connection, key, value, settings.flags, MemcacheExpiry.seconds(settings.expirySeconds), cas)
}

func memcacheCas(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ settings: MemcacheOptions, _ cas: Bytes) -> MemcacheCasResult {
    let result = memcacheCasExecute(connection, key, value, settings, cas)
    match result {
        .stored => result
        .exists => result
        .missing => result
        .notStored => result
        .requestFailure => result
        _ => {
            let closed = connection.close()
            result
        }
    }
}
variant MemcacheManyResult {
    values(MemcacheManyReply)
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
func memcacheManyReceive(_ connection: TcpConnection, _ stream: MemcacheManyStream, _ keys: Bytes, _ withCas: bool) -> MemcacheManyStream {
    if stream.kind == 0 {
        guard stream.bytes.count < 8192 else { nil }
        let reading = connection.receive(8192 - stream.bytes.count, 1000)
        guard let chunk = reading else { nil }
        guard chunk.count > 0 else { nil }
        guard let bytes = concatBytes(stream.bytes, chunk, 8192) else { nil }
        memcacheManyFeed(bytes, keys, withCas)
    } else { stream }
}
func memcacheManyReadPair(_ connection: TcpConnection, _ stream: MemcacheManyStream, _ keys: Bytes, _ withCas: bool) -> MemcacheManyStream {
    let readingFirst = memcacheManyReceive(connection, stream, keys, withCas)
    guard let first = readingFirst else { nil }
    let readingSecond = memcacheManyReceive(connection, first, keys, withCas)
    guard let second = readingSecond else { nil }
    second
}
func memcacheManyRead(_ connection: TcpConnection, _ keys: Bytes, _ withCas: bool) -> MemcacheManyStream {
    let initial = MemcacheManyStream(bytes: b"", kind: 0, count: 0)
    let readingFirst = memcacheManyReadPair(connection, initial, keys, withCas)
    guard let first = readingFirst else { nil }
    let readingSecond = memcacheManyReadPair(connection, first, keys, withCas)
    guard let second = readingSecond else { nil }
    second
}
func memcacheManyReadFailure(_ code: i32) -> MemcacheManyResult {
    if code == 0 { MemcacheManyResult.replyFailure } else { MemcacheManyResult.transportFailure(code) }
}
func memcacheManyWire(_ connection: TcpConnection, _ request: Bytes, _ keys: Bytes, _ withCas: bool) -> MemcacheManyResult {
    let sending = connection.send(request, 1000)
    guard let sent = sending else { MemcacheManyResult.transportFailure(netError()) }
    let reading = memcacheManyRead(connection, keys, withCas)
    guard let stream = reading else { memcacheManyReadFailure(netError()) }
    if stream.kind == 8 {
        let token = memcacheValueToken(stream.bytes, 0, withCas)
        MemcacheManyResult.serverError(token.data)
    } else {
        guard stream.kind == 2 else { MemcacheManyResult.replyFailure }
        MemcacheManyResult.values(MemcacheManyReply(frame: stream.bytes, keys: keys, withCas: withCas, count: stream.count))
    }
}

func memcacheManyExpiryExecute(_ connection: TcpConnection, _ keys: MemcacheKeys, _ mode: MemcacheRetrievalMode,
    _ expiry: MemcacheExpiry) -> MemcacheManyResult {
    guard let request = memcacheManyExpiryRequest(keys, mode, expiry) else { MemcacheManyResult.requestFailure }
    let result = memcacheManyWire(connection, request, keys.bytes, memcacheRetrievalCas(mode))
    match result {
        .values(reply) => result
        _ => {
            let closed = connection.close()
            result
        }
    }
}
func memcacheManyExecute(_ connection: TcpConnection, _ keys: MemcacheKeys, _ mode: MemcacheRetrievalMode, _ seconds: i32) -> MemcacheManyResult {
    memcacheManyExpiryExecute(connection, keys, mode, MemcacheExpiry.seconds(seconds))
}

func memcacheMultiGet(_ connection: TcpConnection, _ keys: MemcacheKeys) -> MemcacheManyResult {
    memcacheManyExecute(connection, keys, MemcacheRetrievalMode.plain, 0)
}
func memcacheMultiGets(_ connection: TcpConnection, _ keys: MemcacheKeys) -> MemcacheManyResult {
    memcacheManyExecute(connection, keys, MemcacheRetrievalMode.cas, 0)
}
func memcacheMultiGat(_ connection: TcpConnection, _ keys: MemcacheKeys, _ seconds: i32) -> MemcacheManyResult {
    memcacheManyExecute(connection, keys, MemcacheRetrievalMode.touching, seconds)
}
func memcacheMultiGats(_ connection: TcpConnection, _ keys: MemcacheKeys, _ seconds: i32) -> MemcacheManyResult {
    memcacheManyExecute(connection, keys, MemcacheRetrievalMode.touchingCas, seconds)
}
struct MemcacheCasItem { data: Bytes flags: Bytes cas: Bytes }
variant MemcacheGetsResult {
    value(MemcacheCasItem)
    missing
    serverError(Bytes)
    requestFailure
    transportFailure(i32)
    replyFailure
}
func memcacheGetsItem(_ reply: MemcacheManyReply) -> MemcacheGetsResult {
    if reply.count == 0 { MemcacheGetsResult.missing } else {
        guard reply.count == 1 else { MemcacheGetsResult.replyFailure }
        guard let item = memcacheManyItem(reply, 0) else { MemcacheGetsResult.replyFailure }
        MemcacheGetsResult.value(MemcacheCasItem(data: item.data, flags: item.flags, cas: item.cas))
    }
}
func memcacheGetsResult(_ result: MemcacheManyResult) -> MemcacheGetsResult {
    match result {
        .values(reply) => memcacheGetsItem(reply)
        .serverError(data) => MemcacheGetsResult.serverError(data)
        .requestFailure => MemcacheGetsResult.requestFailure
        .transportFailure(code) => MemcacheGetsResult.transportFailure(code)
        _ => MemcacheGetsResult.replyFailure
    }
}
func memcacheGetsFinish(_ connection: TcpConnection, _ result: MemcacheGetsResult) -> MemcacheGetsResult {
    match result {
        .value(item) => result
        .missing => result
        .requestFailure => result
        _ => {
            let closed = connection.close()
            result
        }
    }
}
func memcacheGets(_ connection: TcpConnection, _ key: Bytes) -> MemcacheGetsResult {
    let result = memcacheManyExecute(connection, MemcacheKeys(bytes: key, count: 1), MemcacheRetrievalMode.cas, 0)
    memcacheGetsFinish(connection, memcacheGetsResult(result))
}
func memcacheGats(_ connection: TcpConnection, _ key: Bytes, _ seconds: i32) -> MemcacheGetsResult {
    let result = memcacheManyExecute(connection, MemcacheKeys(bytes: key, count: 1), MemcacheRetrievalMode.touchingCas, seconds)
    memcacheGetsFinish(connection, memcacheGetsResult(result))
}
func memcacheGatItem(_ reply: MemcacheManyReply) -> MemcacheGetResult {
    if reply.count == 0 { MemcacheGetResult.missing } else {
        guard reply.count == 1 else { MemcacheGetResult.replyFailure }
        guard let item = memcacheManyItem(reply, 0) else { MemcacheGetResult.replyFailure }
        MemcacheGetResult.value(MemcacheItem(data: item.data, flags: item.flags))
    }
}
func memcacheGatResult(_ result: MemcacheManyResult) -> MemcacheGetResult {
    match result {
        .values(reply) => memcacheGatItem(reply)
        .serverError(data) => MemcacheGetResult.serverError(data)
        .requestFailure => MemcacheGetResult.requestFailure
        .transportFailure(code) => MemcacheGetResult.transportFailure(code)
        _ => MemcacheGetResult.replyFailure
    }
}
func memcacheGat(_ connection: TcpConnection, _ key: Bytes, _ seconds: i32) -> MemcacheGetResult {
    let result = memcacheManyExecute(connection, MemcacheKeys(bytes: key, count: 1), MemcacheRetrievalMode.touching, seconds)
    let converted = memcacheGatResult(result)
    if memcacheGetMustClose(converted) {
        let closed = connection.close()
        converted
    } else { converted }
}

// Explicit expiry choices; legacy relative-TTL entry points retain their contracts.
func memcacheStoreWithExpiry(_ connection: TcpConnection, _ mode: MemcacheStoreMode,
    _ key: Bytes, _ value: Bytes, _ flags: Bytes, _ expiry: MemcacheExpiry) -> MemcacheStoreResult {
    let result = memcacheStoreExpiryExecute(connection, mode, key, value, flags, expiry)
    if memcacheStoreMustClose(result) {
        let closed = connection.close()
        result
    } else { result }
}
func memcacheCasWithExpiry(_ connection: TcpConnection, _ key: Bytes, _ value: Bytes, _ flags: Bytes, _ expiry: MemcacheExpiry, _ cas: Bytes) -> MemcacheCasResult {
    let result = memcacheCasExpiryExecute(connection, key, value, flags, expiry, cas)
    match result {
        .stored => result
        .exists => result
        .missing => result
        .notStored => result
        .requestFailure => result
        _ => {
            let closed = connection.close()
            result
        }
    }
}
func memcacheTouchWithExpiry(_ connection: TcpConnection, _ key: Bytes, _ expiry: MemcacheExpiry) -> MemcacheCommandResult {
    guard let request = memcacheTouchExpiryRequest(key, expiry) else { MemcacheCommandResult.requestFailure }
    memcacheCommandFinish(connection, memcacheCommandWire(connection, request, key, 7))
}
func memcacheMultiGatWithExpiry(_ connection: TcpConnection, _ keys: MemcacheKeys, _ expiry: MemcacheExpiry) -> MemcacheManyResult {
    memcacheManyExpiryExecute(connection, keys, MemcacheRetrievalMode.touching, expiry)
}
func memcacheMultiGatsWithExpiry(_ connection: TcpConnection, _ keys: MemcacheKeys, _ expiry: MemcacheExpiry) -> MemcacheManyResult {
    memcacheManyExpiryExecute(connection, keys, MemcacheRetrievalMode.touchingCas, expiry)
}
func memcacheGatsWithExpiry(_ connection: TcpConnection, _ key: Bytes, _ expiry: MemcacheExpiry) -> MemcacheGetsResult {
    let result = memcacheMultiGatsWithExpiry(connection, MemcacheKeys(bytes: key, count: 1), expiry)
    memcacheGetsFinish(connection, memcacheGetsResult(result))
}
func memcacheGatWithExpiry(_ connection: TcpConnection, _ key: Bytes, _ expiry: MemcacheExpiry) -> MemcacheGetResult {
    let result = memcacheMultiGatWithExpiry(connection, MemcacheKeys(bytes: key, count: 1), expiry)
    let converted = memcacheGatResult(result)
    if memcacheGetMustClose(converted) {
        let closed = connection.close()
        converted
    } else { converted }
}
