// Set JWT_SECRET (at least 32 bytes), JWT_ISSUER and JWT_AUDIENCE at load time.
// Serve behind TLS. Signature verification and claims policy are separate steps.
import Crypto
import "middleware/auth.rut"
listen :8080

route GET "/identity" {
    let document = auth.jwtDocumentHs256(req.authorization.or(""), env("JWT_SECRET"))
    let identity = auth.jwtIdentity(document, env("JWT_ISSUER"), env("JWT_AUDIENCE"), "issuer-key")
    let subject = identity.consumerId
    return response(200, body: subject)
}

route GET "/orders" {
    let document = auth.jwtDocumentHs256(req.authorization.or(""), env("JWT_SECRET"))
    let identity = auth.jwtIdentity(document, env("JWT_ISSUER"), env("JWT_AUDIENCE"), "issuer-key")
    guard jwtHasScope(document, "orders:read") else { return response(403, headers: {"WWW-Authenticate": "Bearer error=\"insufficient_scope\""}) }
    let subject = identity.consumerId
    return response(200, body: subject)
}

// Optional static revocation: these IDs belong to JWT_ISSUER only. Replace the
// snapshot and reload configuration to add or remove revoked tokens.
route GET "/revocation-example" {
    guard let document = Crypto.jwtHs256(bearerToken(req.authorization.or("")).or(""), env("JWT_SECRET")) else { return 401 }
    guard jwtClaimsValid(document, env("JWT_ISSUER"), env("JWT_AUDIENCE")) else { return 401 }
    let checked = auth.requireUnrevokedJwt(document, "revoked-token-1", "revoked-token-2")
    guard jwtHasScope(checked, "orders:read") else { return 403 }
    return 200
}
