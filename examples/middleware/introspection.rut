// Service credentials are trusted configuration, distinct from the client token.
func request(_ authorization: str, _ serviceAuthorization: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard let token = bearerToken(authorization) else { respond denied }
    guard let message = oauthIntrospectionRequest(token, serviceAuthorization) else { respond 503 }
    message
}

// An HTTP 200 is only a completed exchange; active/expiry/audience policy follows.
func replyDocument(_ reply: Json) -> Json {
    guard json.bool(json.get(reply, "/ok").or(reply)).or(false) &&
        json.int(json.get(reply, "/status").or(reply)).or(0) == 200 else { nil }
    json.parse(json.string(json.get(reply, "/body").or(reply)).or(""))
}

func requireActive(_ reply: Json, _ audience: str) -> Json {
    guard let document = replyDocument(reply) else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard oauthIntrospectionValid(document, audience) else { respond denied }
    document
}

// Project only checked AS metadata; this does not authenticate arbitrary JSON.
func subject(_ document: Json) -> str {
    let value = json.string(json.get(document, "/sub").or(document)).or("")
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard value != "" else { respond denied }
    value
}

func requireScope(_ document: Json, _ scope: str) -> Json {
    guard scope != "" else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, scope) else { respond denied }
    document
}

// Validate a configured single permission with the shared OAuth scope grammar.
// This constructs policy JSON, not authenticated AS metadata.
func scopePolicyValid(_ scope: str) -> bool {
    guard let policy = json.value({scope: scope}) else { false }
    jwtHasScope(policy, scope)
}

// Apply only after requireActive over the authenticated AS reply. Validate both
// configured permissions before OR can short-circuit on an allowed permission.
func requireEitherScope(_ document: Json, _ first: str, _ second: str) -> Json {
    guard scopePolicyValid(first) && scopePolicyValid(second) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, first) || jwtHasScope(document, second) else { respond denied }
    document
}

func requireBothScopes(_ document: Json, _ first: str, _ second: str) -> Json {
    guard scopePolicyValid(first) && scopePolicyValid(second) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, first) && jwtHasScope(document, second) else { respond denied }
    document
}

// Exact metadata comparison only: this cannot authenticate caller-supplied JSON.
func bindingMatches(_ document: Json, _ issuer: str, _ clientId: str) -> bool {
    issuer != "" && clientId != "" && json.kind(document).or("") == "object" &&
        json.string(json.get(document, "/iss").or(document)).or("") == issuer &&
        json.string(json.get(document, "/client_id").or(document)).or("") == clientId
}

// Optional resource policy, after requireActive over the authenticated AS reply.
// Token issuer/client metadata is distinct from introspection service credentials.
func requireBinding(_ document: Json, _ issuer: str, _ clientId: str) -> Json {
    guard issuer != "" && clientId != "" else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard bindingMatches(document, issuer, clientId) else { respond denied }
    document
}
