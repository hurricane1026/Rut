// Service credentials are trusted configuration, distinct from the client token.
func request(_ authorization: str, _ serviceAuthorization: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard let token = bearerToken(authorization) else { respond denied }
    guard let message = oauthIntrospectionRequest(token, serviceAuthorization) else { respond 503 }
    message
}

// An HTTP 200 is only a completed exchange; active/expiry/audience policy follows.
func replyDocument(_ reply: Json) -> Json {
    guard json.bool(json.get(reply, "/ok").or(reply)).or(false) &&
        json.int(json.get(reply, "/status").or(reply)).or(0) == 200 else { nil }
    json.parse(json.string(json.get(reply, "/body").or(reply)).or(""))
}

func requireActive(_ reply: Json, _ audience: str) -> Json {
    guard let document = replyDocument(reply) else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard oauthIntrospectionValid(document, audience) else { respond denied }
    document
}

// Project only checked AS metadata; this does not authenticate arbitrary JSON.
func subject(_ document: Json) -> str {
    let value = json.string(json.get(document, "/sub").or(document)).or("")
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard value != "" else { respond denied }
    value
}

func requireScope(_ document: Json, _ scope: str) -> Json {
    guard scope != "" else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, scope) else { respond denied }
    document
}
