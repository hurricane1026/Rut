// Service credentials are trusted configuration, distinct from the client token.
func request(_ authorization: str, _ serviceAuthorization: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard let token = bearerToken(authorization) else { respond denied }
    guard let message = oauthIntrospectionRequest(token, serviceAuthorization) else { respond 503 }
    message
}

// An HTTP 200 is only a completed exchange; active/expiry/audience policy follows.
func replyDocument(_ reply: Json) -> Json {
    guard json.bool(json.get(reply, "/ok").or(reply)).or(false) &&
        json.int(json.get(reply, "/status").or(reply)).or(0) == 200 else { nil }
    json.parse(json.string(json.get(reply, "/body").or(reply)).or(""))
}

func requireActive(_ reply: Json, _ audience: str) -> Json {
    guard let document = replyDocument(reply) else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard oauthIntrospectionValid(document, audience) else { respond denied }
    document
}

// Project only checked AS metadata; this does not authenticate arbitrary JSON.
func subject(_ document: Json) -> str {
    let value = json.string(json.get(document, "/sub").or(document)).or("")
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard value != "" else { respond denied }
    value
}

func requireScope(_ document: Json, _ scope: str) -> Json {
    guard scope != "" else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, scope) else { respond denied }
    document
}

// Validate a configured single permission with the shared OAuth scope grammar.
// This constructs policy JSON, not authenticated AS metadata.
func scopePolicyValid(_ scope: str) -> bool {
    guard let policy = json.value({scope: scope}) else { false }
    jwtHasScope(policy, scope)
}

// Apply only after requireActive over the authenticated AS reply. Validate both
// configured permissions before OR can short-circuit on an allowed permission.
func requireEitherScope(_ document: Json, _ first: str, _ second: str) -> Json {
    guard scopePolicyValid(first) && scopePolicyValid(second) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, first) || jwtHasScope(document, second) else { respond denied }
    document
}

func requireBothScopes(_ document: Json, _ first: str, _ second: str) -> Json {
    guard scopePolicyValid(first) && scopePolicyValid(second) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, first) && jwtHasScope(document, second) else { respond denied }
    document
}

func scopeListPolicyValid(_ required: str) -> bool {
    guard let policy = json.value({scope: required}) else { false }
    jwtHasAnyScope(policy, required)
}

// A bounded list of alternative permissions in trusted route configuration.
func requireAnyScope(_ document: Json, _ required: str) -> Json {
    guard scopeListPolicyValid(required) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasAnyScope(document, required) else { respond denied }
    document
}

// Require the entire trusted scope list.
func requireAllScopes(_ document: Json, _ required: str) -> Json {
    guard scopeListPolicyValid(required) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasAllScopes(document, required) else { respond denied }
    document
}

// Apply only to metadata that passed requireActive.
func requireNoScopes(_ document: Json, _ forbidden: str) -> Json {
    guard scopeListPolicyValid(forbidden) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard !jwtHasAnyScope(document, forbidden) else { respond denied }
    document
}

// Exact metadata comparison only: this cannot authenticate caller-supplied JSON.
func bindingMatches(_ document: Json, _ issuer: str, _ clientId: str) -> bool {
    issuer != "" && clientId != "" && json.kind(document).or("") == "object" &&
        json.string(json.get(document, "/iss").or(document)).or("") == issuer &&
        json.string(json.get(document, "/client_id").or(document)).or("") == clientId
}

// Optional resource policy, after requireActive over the authenticated AS reply.
// Token issuer/client metadata is distinct from introspection service credentials.
func requireBinding(_ document: Json, _ issuer: str, _ clientId: str) -> Json {
    guard issuer != "" && clientId != "" else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard bindingMatches(document, issuer, clientId) else { respond denied }
    document
}

// Bind an active token to an exact issuer, client and subject together.
func requirePrincipal(_ document: Json, _ issuer: str, _ clientId: str, _ expectedSubject: str) -> Json {
    guard issuer != "" && clientId != "" && expectedSubject != "" else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    let actual = json.string(json.get(document, "/sub").or(document)).or("")
    guard bindingMatches(document, issuer, clientId) && actual == expectedSubject else { respond denied }
    document
}

func lifetimeMatches(_ document: Json, _ issuer: str, _ audience: str, _ maxAge: i32, _ maxLifetime: i32) -> bool {
    let actualIssuer = json.string(json.get(document, "/iss").or(document)).or("")
    let issued = json.int(json.get(document, "/iat").or(document)).or(0)
    let expires = json.int(json.get(document, "/exp").or(document)).or(0)
    // The JWT timing primitive requires a subject. This internal projection
    // lets it check the dates while the original metadata supplies AS policy.
    guard let times = json.value({
        sub: "introspection-lifetime", iss: issuer, aud: audience, iat: issued, exp: expires
    }) else { false }
    actualIssuer == issuer && oauthIntrospectionValid(document, audience) &&
        jwtClaimsValidWithLifetime(times, issuer, audience, i64(maxAge), i64(maxLifetime))
}

// Apply to metadata parsed from the fixed HTTPS introspection response.
func requireLifetime(_ document: Json, _ issuer: str, _ audience: str, _ maxAge: i32, _ maxLifetime: i32) -> Json {
    guard issuer != "" && audience != "" && maxAge > 0 && maxLifetime > 0 else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard lifetimeMatches(document, issuer, audience, maxAge, maxLifetime) else { respond denied }
    document
}

// RFC 8705: bind authenticated AS metadata to this TLS connection. Call only
// after requireActive; request JSON and forwarded certificate headers are untrusted.
func requireMtls(_ document: Json) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard jwtCertificateBound(document, req.tlsClientCertSha256.or("")) else { respond denied }
    document
}

// Compare optional metadata only after the authenticated AS reply passed requireActive.
func requireMetadataValue(_ document: Json, _ field: str, _ expected: str) -> Json {
    guard expected != "" && Bytes(expected).count <= 256 else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard json.string(json.get(document, field).or(document)).or("") == expected else { respond denied }
    document
}

// Exact comparison for AS profiles that publish a configured token_type spelling.
func requireTokenType(_ document: Json, _ expected: str) -> Json {
    requireMetadataValue(document, "/token_type", expected)
}

// A username is an additional restriction, while /sub remains the stable identifier.
func requireUsername(_ document: Json, _ expected: str) -> Json {
    requireMetadataValue(document, "/username", expected)
}

func requireSessionId(_ document: Json, _ expected: str) -> Json {
    requireMetadataValue(document, "/sid", expected)
}

func requireTokenId(_ document: Json, _ expected: str) -> Json {
    requireMetadataValue(document, "/jti", expected)
}

// Require a nonempty scope grant with no privileges outside the route allowlist.
func requireOnlyScopes(_ document: Json, _ allowed: str) -> Json {
    guard let policy = json.value({scope: allowed}) else { respond 503 }
    guard jwtHasAnyScope(policy, allowed) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    let grant = json.string(json.get(document, "/scope").or(document)).or("")
    guard jwtHasAllScopes(policy, grant) else { respond denied }
    document
}
