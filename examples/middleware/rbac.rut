// Exact, bounded role-to-resource/action policy. Pass only an identity returned
// by a trusted authenticator and trusted route configuration.
struct Rule {
    tenant: str
    role: str
    resource: str
    action: str
    effect: str
}

struct TenantBinding {
    consumerId: str
    tenant: str
}

func validConsumerId(_ value: str) -> bool {
    Bytes(value).count >= 1 && Bytes(value).count <= 64 &&
        value.matches(re"^[\x21-\x7e]+$")
}

func validTenantBinding(_ binding: TenantBinding) -> bool {
    let empty = binding.consumerId == "" && binding.tenant == ""
    let complete = validConsumerId(binding.consumerId) &&
        Bytes(binding.tenant).count >= 1 && Bytes(binding.tenant).count <= 128
    empty || complete
}

func validTenantPolicy(_ tenant: str, _ first: TenantBinding,
                       _ second: TenantBinding, _ third: TenantBinding,
                       _ fourth: TenantBinding) -> bool {
    let valid = Bytes(tenant).count >= 1 && Bytes(tenant).count <= 128 &&
        validTenantBinding(first) && validTenantBinding(second) &&
        validTenantBinding(third) && validTenantBinding(fourth)
    let any = first.consumerId != "" || second.consumerId != "" ||
        third.consumerId != "" || fourth.consumerId != ""
    let unique = (first.consumerId == "" || first.consumerId != second.consumerId) &&
        (first.consumerId == "" || first.consumerId != third.consumerId) &&
        (first.consumerId == "" || first.consumerId != fourth.consumerId) &&
        (second.consumerId == "" || second.consumerId != third.consumerId) &&
        (second.consumerId == "" || second.consumerId != fourth.consumerId) &&
        (third.consumerId == "" || third.consumerId != fourth.consumerId)
    valid && any && unique
}

func tenantMatches(_ consumerId: str, _ tenant: str,
                   _ first: TenantBinding, _ second: TenantBinding,
                   _ third: TenantBinding, _ fourth: TenantBinding) -> bool {
    (first.consumerId == consumerId && first.tenant == tenant) ||
        (second.consumerId == consumerId && second.tenant == tenant) ||
        (third.consumerId == consumerId && third.tenant == tenant) ||
        (fourth.consumerId == consumerId && fourth.tenant == tenant)
}

func identityConsumerId(_ identity: Json) -> str {
    guard let idField = json.get(identity, "/consumerId") else { "" }
    json.string(idField).or("")
}

// Bind verified Consumer IDs to trusted route tenant names. Validate every
// slot, including slots unrelated to this request, before matching identity.
func requireTenant(_ identity: Json, _ tenant: str,
                   _ first: TenantBinding, _ second: TenantBinding,
                   _ third: TenantBinding, _ fourth: TenantBinding) -> Json {
    guard validTenantPolicy(tenant, first, second, third, fourth) else { respond 503 }
    let consumerId = identityConsumerId(identity)
    guard validConsumerId(consumerId) && tenantMatches(consumerId, tenant, first, second, third, fourth) else { respond 403 }
    identity
}

func validRule(_ rule: Rule) -> bool {
    let empty = rule.tenant == "" && rule.role == "" && rule.resource == "" &&
        rule.action == "" && rule.effect == ""
    let complete = Bytes(rule.tenant).count > 0 && Bytes(rule.tenant).count <= 128 &&
        Bytes(rule.role).count > 0 && Bytes(rule.role).count <= 128 &&
        Bytes(rule.resource).count > 0 && Bytes(rule.resource).count <= 128 &&
        Bytes(rule.action).count > 0 && Bytes(rule.action).count <= 128 &&
        (rule.effect == "allow" || rule.effect == "deny")
    empty || complete
}

func matches(_ rule: Rule, _ tenant: str, _ resource: str, _ action: str) -> bool {
    rule.tenant == tenant && rule.resource == resource && rule.action == action
}

// Validate the complete bounded policy before evaluation. Exact deny rules
// override every matching allow rule; no match is default deny.
func require(_ identity: Json, _ tenant: str, _ resource: str, _ action: str,
             _ first: Rule, _ second: Rule, _ third: Rule, _ fourth: Rule) -> Json {
    guard Bytes(tenant).count > 0 && Bytes(tenant).count <= 128 &&
        Bytes(resource).count > 0 && Bytes(resource).count <= 128 &&
        Bytes(action).count > 0 && Bytes(action).count <= 128 &&
        validRule(first) && validRule(second) && validRule(third) && validRule(fourth) else { respond 503 }
    let any = first.role != "" || second.role != "" || third.role != "" || fourth.role != ""
    guard any else { respond 503 }
    let denied = (matches(first, tenant, resource, action) && first.effect == "deny" && jwtHasGroup(identity, first.role)) ||
        (matches(second, tenant, resource, action) && second.effect == "deny" && jwtHasGroup(identity, second.role)) ||
        (matches(third, tenant, resource, action) && third.effect == "deny" && jwtHasGroup(identity, third.role)) ||
        (matches(fourth, tenant, resource, action) && fourth.effect == "deny" && jwtHasGroup(identity, fourth.role))
    guard !denied else { respond 403 }
    let allowed = (matches(first, tenant, resource, action) && first.effect == "allow" && jwtHasGroup(identity, first.role)) ||
        (matches(second, tenant, resource, action) && second.effect == "allow" && jwtHasGroup(identity, second.role)) ||
        (matches(third, tenant, resource, action) && third.effect == "allow" && jwtHasGroup(identity, third.role)) ||
        (matches(fourth, tenant, resource, action) && fourth.effect == "allow" && jwtHasGroup(identity, fourth.role))
    guard allowed else { respond 403 }
    identity
}
