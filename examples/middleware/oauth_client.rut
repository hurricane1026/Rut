import "introspection.rut"

// Construct headers with JSON escaping; never interpolate raw credentials.
func clientCredentialsMessage(_ serviceAuthorization: str) -> Json {
    guard let quoted = json.encode(serviceAuthorization) else { nil }
    guard let headers = json.parse("{\"Content-Type\":\"application/x-www-form-urlencoded\",\"Accept\":\"application/json\",\"Authorization\":" + quoted + "}") else { nil }
    json.value({method: "POST", headers: headers, body: "grant_type=client_credentials"})
}

// Trusted, pre-encoded HTTP Basic service credentials. The AS supplies this
// client's default scope; downstream input never selects a grant or credential.
func clientCredentials(_ serviceAuthorization: str) -> Json {
    guard serviceAuthorization.hasPrefix("Basic ") && serviceAuthorization != "Basic " else { respond 503 }
    guard let built = clientCredentialsMessage(serviceAuthorization) else { respond 503 }
    built
}

// Explicit trusted scope list; form metacharacters are encoded by the builtin.
func clientCredentialsForScope(_ serviceAuthorization: str, _ scopes: str) -> Json {
    guard let built = oauthClientCredentialsRequest(scopes, serviceAuthorization) else { respond 503 }
    built
}

// Single trusted HTTPS resource identifier, never a caller-selected URL.
func clientCredentialsForResource(_ serviceAuthorization: str, _ scopes: str, _ resource: str) -> Json {
    guard let built = oauthClientCredentialsRequest(scopes, serviceAuthorization, resource) else { respond 503 }
    built
}

// Metadata policy only; callers must first authenticate/parse the AS response.
func authorizationDocument(_ document: Json, _ requiredScope: str) -> str {
    let token = json.string(json.get(document, "/access_token").or(document)).or("")
    let kind = json.string(json.get(document, "/token_type").or(document)).or("")
    let lifetime = json.int(json.get(document, "/expires_in").or(document)).or(0)
    let checked = bearerToken(kind + " " + token).or("")
    guard requiredScope != "" && lifetime > 0 && json.get(document, "/error") == nil &&
        !kind.contains(" ") && !token.isEmpty && checked == token &&
        jwtHasScope(document, requiredScope) else { respond 503 }
    "Bearer " + token
}

// Only consume a completed httpCall response from the configured HTTPS AS.
// No caching: expiry is checked as positive integer lifetime metadata at receipt.
func authorization(_ reply: Json, _ requiredScope: str) -> str {
    guard let document = introspection.replyDocument(reply) else { respond 503 }
    authorizationDocument(document, requiredScope)
}

// Exchange a caller's singleton Bearer access token under trusted AS policy.
func tokenExchange(_ authorization: str, _ serviceAuthorization: str, _ policy: Json) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard let token = bearerToken(authorization) else { respond denied }
    guard let message = oauthTokenExchangeRequest(token, serviceAuthorization, policy) else { respond 503 }
    message
}

// Only an OAuth access token may enter the normal Bearer/expiry/scope policy.
func exchangeAuthorization(_ reply: Json, _ requiredScope: str) -> str {
    guard let document = introspection.replyDocument(reply) else { respond 503 }
    guard json.string(json.get(document, "/issued_token_type").or(document)).or("") == "urn:ietf:params:oauth:token-type:access_token" else { respond 503 }
    authorizationDocument(document, requiredScope)
}
