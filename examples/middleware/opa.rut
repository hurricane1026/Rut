// OPA Data API over a caller-selected, configuration-owned httpCall endpoint.
// Supply authenticated identity and explicitly selected request context as input.
// No client headers, credentials or identity fields are copied implicitly.
func request(_ input: Json) -> Json {
    guard let envelope = json.value({input: input}) else { nil }
    guard let body = json(envelope) else { nil }
    guard let headers = json.parse("{\"Content-Type\":\"application/json\"}") else { nil }
    json.value({method: "POST", headers: headers, body: body})
}

// Internal transport validation. HTTP success alone never grants access.
// Pass only a result from httpCall, not JSON supplied by the downstream client.
func document(_ reply: Json) -> Json {
    guard json.bool(json.get(reply, "/ok").or(reply)).or(false) &&
        json.int(json.get(reply, "/status").or(reply)).or(0) == 200 else { nil }
    guard let parsed = json.parse(json.string(json.get(reply, "/body").or(reply)).or("")) else { nil }
    guard json.kind(parsed).or("") == "object" else { nil }
    parsed
}

// Boolean rule: {"result": true}. OPA omits result for undefined rules.
// Explicit false / undefined => 403; malformed or unavailable service => 503.
func booleanStatus(_ parsed: Json) -> i32 {
    guard let result = json.get(parsed, "/result") else { 403 }
    guard let allow = json.bool(result) else { 503 }
    if allow { 200 } else { 403 }
}

func requireAllow(_ reply: Json) -> Json {
    guard let parsed = document(reply) else { respond 503 }
    let status = booleanStatus(parsed)
    guard status != 503 else { respond 503 }
    guard status == 200 else { respond 403 }
    parsed
}

// Structured rule: {"result": {"allow": true, ...}}. Return the decision
// object only after allow succeeds; callers explicitly validate/map other fields.
func requireDecision(_ reply: Json) -> Json {
    guard let parsed = document(reply) else { respond 503 }
    guard let result = json.get(parsed, "/result") else { respond 403 }
    // parsed is an object, so the fallback can never decode as Boolean.
    guard let allow = json.bool(json.get(result, "/allow").or(parsed)) else { respond 503 }
    guard allow else { respond 403 }
    result
}

// Apply only to the allow decision returned by requireDecision.
func tenantStatus(_ decision: Json, _ tenant: str) -> i32 {
    guard tenant != "" else { 503 }
    guard let actual = json.string(json.get(decision, "/tenant").or(decision)) else { 503 }
    if actual == tenant { 200 } else { 403 }
}

// Bind the allow result to a trusted policy revision.
func revisionStatus(_ decision: Json, _ expected: str) -> i32 {
    guard expected != "" && Bytes(expected).count <= 256 else { 503 }
    guard let revision = json.string(json.get(decision, "/revision").or(decision)) else { 503 }
    guard revision == expected else { 503 }
    200
}

// The caller supplies the subject obtained from its authentication policy.
func subjectStatus(_ decision: Json, _ expected: str) -> i32 {
    guard expected != "" && Bytes(expected).count <= 256 else { 503 }
    guard let subject = json.string(json.get(decision, "/subject").or(decision)) else { 503 }
    guard subject == expected else { 403 }
    200
}

func resourceActionStatus(_ decision: Json, _ resource: str, _ action: str) -> i32 {
    guard resource != "" && Bytes(resource).count <= 256 &&
        action != "" && Bytes(action).count <= 64 else { 503 }
    guard let actualResource = json.string(json.get(decision, "/resource").or(decision)) else { 503 }
    guard let actualAction = json.string(json.get(decision, "/action").or(decision)) else { 503 }
    guard actualResource == resource && actualAction == action else { 403 }
    200
}

// Require every configured delegated permission from the strict scope list.
func delegatedScopesStatus(_ decision: Json, _ required: str) -> i32 {
    guard let policy = json.value({scope: required}) else { 503 }
    guard jwtHasAnyScope(policy, required) else { 503 }
    guard let grant = json.string(json.get(decision, "/scope").or(decision)) else { 503 }
    guard jwtHasAnyScope(decision, grant) else { 503 }
    guard jwtHasAllScopes(decision, required) else { 403 }
    200
}

// The backend supplies an absolute Unix-second expiration for its decision.
func freshDecisionStatus(_ decision: Json) -> i32 {
    guard let expiry = json.int(json.get(decision, "/expires_at").or(decision)) else { 503 }
    guard expiry > 0 else { 503 }
    guard let times = json.value({iss: "rut", aud: "rut", sub: "rut", exp: expiry}) else { 503 }
    guard jwtClaimsValid(times, "rut", "rut") else { 503 }
    200
}
