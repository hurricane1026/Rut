// Apply only after signature, issuer, audience and time verification.
// Expected values come from trusted route configuration.
func selectorValid(_ value: str) -> bool {
    value != "" && Bytes(value).count <= 256
}

func requireAcr(_ document: Json, _ expected: str) -> Json {
    guard selectorValid(expected) else { respond 503 }
    guard json.string(json.get(document, "/acr").or(document)).or("") == expected else { respond 403 }
    document
}

func methodGroups(_ document: Json) -> Json {
    guard let methods = json.get(document, "/amr") else { nil }
    json.value({groups: methods})
}

func requireAmr(_ document: Json, _ expected: str) -> Json {
    guard selectorValid(expected) else { respond 503 }
    guard let methods = methodGroups(document) else { respond 403 }
    guard jwtHasGroup(methods, expected) else { respond 403 }
    document
}

func authenticationAgeMatches(_ document: Json, _ maxAge: i32) -> bool {
    let authTime = json.int(json.get(document, "/auth_time").or(document)).or(0)
    let issued = json.int(json.get(document, "/iat").or(document)).or(0)
    let expiry = json.int(json.get(document, "/exp").or(document)).or(0)
    guard authTime > 0 && authTime <= issued else { false }
    guard let times = json.value({iss: "rut", aud: "rut", sub: "rut",
                                  iat: authTime, exp: expiry}) else { false }
    let limit = parseInt64("9223372036854775807").or(0)
    jwtClaimsValidWithLifetime(times, "rut", "rut", i64(maxAge), limit)
}

func requireAuthenticationAge(_ document: Json, _ maxAge: i32) -> Json {
    guard maxAge > 0 else { respond 503 }
    guard authenticationAgeMatches(document, maxAge) else { respond 403 }
    document
}

func requireVerifiedEmail(_ document: Json, _ expected: str) -> Json {
    guard selectorValid(expected) else { respond 503 }
    guard json.bool(json.get(document, "/email_verified").or(document)).or(false) &&
        json.string(json.get(document, "/email").or(document)).or("") == expected else { respond 403 }
    document
}

func requireSession(_ document: Json, _ expected: str) -> Json {
    guard selectorValid(expected) else { respond 503 }
    guard json.string(json.get(document, "/sid").or(document)).or("") == expected else { respond 403 }
    document
}

// ACR is a single class. AMR is a list of methods used in the same authentication.
func requireAnyAcr(_ document: Json, _ first: str, _ second: str) -> Json {
    guard selectorValid(first) && selectorValid(second) else { respond 503 }
    let actual = json.string(json.get(document, "/acr").or(document)).or("")
    guard actual == first || actual == second else { respond 403 }
    document
}

func requireAnyAmr(_ document: Json, _ first: str, _ second: str) -> Json {
    guard selectorValid(first) && selectorValid(second) else { respond 503 }
    guard let methods = methodGroups(document) else { respond 403 }
    guard jwtHasGroup(methods, first) || jwtHasGroup(methods, second) else { respond 403 }
    document
}

func requireAllAmr(_ document: Json, _ first: str, _ second: str) -> Json {
    guard selectorValid(first) && selectorValid(second) && first != second else { respond 503 }
    guard let methods = methodGroups(document) else { respond 403 }
    guard jwtHasGroup(methods, first) && jwtHasGroup(methods, second) else { respond 403 }
    document
}

func requireAmrWithout(_ document: Json, _ required: str, _ forbidden: str) -> Json {
    guard selectorValid(required) && selectorValid(forbidden) && required != forbidden else { respond 503 }
    guard let methods = methodGroups(document) else { respond 403 }
    guard jwtHasGroup(methods, required) && !jwtHasGroup(methods, forbidden) else { respond 403 }
    document
}

func requireSessionPrincipal(_ document: Json, _ session: str, _ subject: str) -> Json {
    guard selectorValid(session) && selectorValid(subject) else { respond 503 }
    guard json.string(json.get(document, "/sid").or(document)).or("") == session &&
        json.string(json.get(document, "/sub").or(document)).or("") == subject else { respond 403 }
    document
}
