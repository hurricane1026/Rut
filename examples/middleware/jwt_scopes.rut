// Metadata authorization only. Authenticate signature/issuer/audience/time first,
// or pass metadata from an authenticated, active introspection response.
// Required scopes are trusted route configuration, not a request header.
func policyValid(_ required: str) -> bool {
    guard let policy = json.value({scope: required}) else { false }
    jwtHasAnyScope(policy, required)
}

func requireAny(_ document: Json, _ required: str) -> Json {
    guard policyValid(required) else { respond 503 }
    let forbidden = response(403)
    forbidden.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasAnyScope(document, required) else { respond forbidden }
    document
}

func requireAll(_ document: Json, _ required: str) -> Json {
    guard policyValid(required) else { respond 503 }
    let forbidden = response(403)
    forbidden.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasAllScopes(document, required) else { respond forbidden }
    document
}

// Missing, empty or malformed grants cannot satisfy a negative check.
func validGrant(_ document: Json) -> str {
    guard let grant = json.string(json.get(document, "/scope").or(document)) else { nil }
    guard policyValid(grant) else { nil }
    grant
}

func requireNone(_ document: Json, _ forbidden: str) -> Json {
    guard policyValid(forbidden) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard let grant = validGrant(document) else { respond denied }
    guard !jwtHasAnyScope(document, forbidden) else { respond denied }
    document
}

func grantsWithin(_ document: Json, _ allowed: str) -> bool {
    guard let grant = validGrant(document) else { false }
    guard let policy = json.value({scope: allowed}) else { false }
    jwtHasAllScopes(policy, grant)
}

func requireOnly(_ document: Json, _ allowed: str) -> Json {
    guard policyValid(allowed) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard grantsWithin(document, allowed) else { respond denied }
    document
}

func requireExact(_ document: Json, _ required: str) -> Json {
    guard policyValid(required) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasAllScopes(document, required) && grantsWithin(document, required) else { respond denied }
    document
}

func requireAnyWithout(_ document: Json, _ required: str, _ forbidden: str) -> Json {
    guard policyValid(required) && policyValid(forbidden) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasAnyScope(document, required) && !jwtHasAnyScope(document, forbidden) else { respond denied }
    document
}

func requireAllWithout(_ document: Json, _ required: str, _ forbidden: str) -> Json {
    guard policyValid(required) && policyValid(forbidden) else { respond 503 }
    let denied = response(403)
    denied.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasAllScopes(document, required) && !jwtHasAnyScope(document, forbidden) else { respond denied }
    document
}
