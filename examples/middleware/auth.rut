import Crypto

// API key authentication. Pass req.authorization.or("") as the first argument.
// Identity is returned only after verification; never derive it from client headers.
struct Identity {
    consumerId: str
    credentialId: str
    method: str
}

// Trusted static configuration, never populated from request headers or JSON.
// Empty secrets disable individual methods; IDs remain stable during revocation.
struct ConsumerCredentials {
    consumerId: str
    key: str
    credentials: str
    keyId: str
    passwordId: str
}

func validConsumerPair(_ first: ConsumerCredentials, _ second: ConsumerCredentials) -> bool {
    first.consumerId != "" && second.consumerId != "" && first.consumerId != second.consumerId &&
        first.keyId != "" && first.passwordId != "" && second.keyId != "" && second.passwordId != "" &&
        (first.key != "" || first.credentials != "" || second.key != "" || second.credentials != "") &&
        (first.key == "" || !Crypto.equal(first.key, second.key)) &&
        (first.credentials == "" || !Crypto.equal(first.credentials, second.credentials))
}

func consumerCredentialsMatch(_ authorization: str, _ consumer: ConsumerCredentials) -> bool {
    let keyMatches = bearerMatches(authorization, consumer.key)
    let passwordMatches = basicMatches(authorization, consumer.credentials)
    keyMatches || passwordMatches
}

// Internal mapping step: call only after consumerCredentialsMatch succeeded.
func matchedConsumerIdentity(_ authorization: str, _ consumer: ConsumerCredentials) -> Identity {
    match bearerMatches(authorization, consumer.key) {
        true => Identity(consumerId: consumer.consumerId, credentialId: consumer.keyId, method: "apiKey")
        _ => Identity(consumerId: consumer.consumerId, credentialId: consumer.passwordId, method: "basic")
    }
}

// Bounded two-consumer OR policy over one singleton Authorization field.
// Ambiguous credential ownership is a configuration error, never first-match wins.
func multiAuth(_ authorization: str, _ first: ConsumerCredentials,
               _ second: ConsumerCredentials) -> Identity {
    let denied = response(401)
    denied.add("WWW-Authenticate", "Bearer")
    denied.add("WWW-Authenticate", "Basic realm=\"rut\"")
    guard validConsumerPair(first, second) else { respond 503 }
    let firstMatches = consumerCredentialsMatch(authorization, first)
    let secondMatches = consumerCredentialsMatch(authorization, second)
    guard firstMatches || secondMatches else { respond denied }
    match firstMatches {
        true => matchedConsumerIdentity(authorization, first)
        _ => matchedConsumerIdentity(authorization, second)
    }
}

// All arguments are positional. key is the opaque key WITHOUT the Bearer prefix.
// Configuration is a snapshot: replace/remove credentials and redeploy to rotate/revoke.
func apiKey(_ authorization: str, _ key: str, _ consumerId: str, _ credentialId: str) -> Identity {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard key != "" && consumerId != "" && credentialId != "" else { respond 503 }
    guard bearerMatches(authorization, key) else {
        respond denied
    }
    Identity(consumerId: consumerId, credentialId: credentialId, method: "apiKey")
}

// Standard Basic authentication; credentials are the configured "user:password" bytes.
func basic(_ authorization: str, _ credentials: str, _ consumerId: str, _ credentialId: str) -> Identity {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Basic realm=\"rut\"")
    guard credentials != "" && consumerId != "" && credentialId != "" else { respond 503 }
    guard basicMatches(authorization, credentials) else { respond denied }
    Identity(consumerId: consumerId, credentialId: credentialId, method: "basic")
}

// AND policy: both an opaque singleton header key and singleton Basic field
// must verify. policyId identifies this configured pair, not a single factor.
func headerKeyAndBasic(_ presentedKey: str, _ authorization: str, _ key: str,
                       _ credentials: str, _ consumerId: str, _ policyId: str) -> Identity {
    let denied = response(401)
    denied.add("WWW-Authenticate", "ApiKey")
    denied.add("WWW-Authenticate", "Basic realm=\"rut\"")
    guard key != "" && credentials != "" && consumerId != "" && policyId != "" else { respond 503 }
    let keyMatches = Crypto.equal(presentedKey, key)
    let passwordMatches = basicMatches(authorization, credentials)
    guard keyMatches && passwordMatches else { respond denied }
    Identity(consumerId: consumerId, credentialId: policyId, method: "apiKeyAndBasic")
}

// Two-key rotation window. Empty keys disable a slot; current wins if both match.
// Remove the previous key to revoke it. Both slots must have stable, nonempty IDs.
func rotatingApiKey(_ authorization: str, _ currentKey: str, _ previousKey: str,
                    _ consumerId: str, _ currentId: str, _ previousId: str) -> Identity {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard consumerId != "" && currentId != "" && previousId != "" else { respond 503 }
    guard currentKey != "" || previousKey != "" else { respond 503 }
    let current = bearerMatches(authorization, currentKey)
    let previous = bearerMatches(authorization, previousKey)
    guard current || previous else { respond denied }
    match current {
        true => Identity(consumerId: consumerId, credentialId: currentId, method: "apiKey")
        _ => Identity(consumerId: consumerId, credentialId: previousId, method: "apiKey")
    }
}

// Custom API key header: pass req.uniqueHeader("X-API-Key").or("").
// Ordinary header() is not sufficient: it can select the first duplicate field.
func headerKey(_ presented: str, _ key: str, _ consumerId: str, _ credentialId: str) -> Identity {
    let denied = response(401)
    denied.set("WWW-Authenticate", "ApiKey")
    guard key != "" && consumerId != "" && credentialId != "" else { respond 503 }
    guard Crypto.equal(presented, key) else { respond denied }
    Identity(consumerId: consumerId, credentialId: credentialId, method: "apiKey")
}

// Anonymous only when the ORIGINAL Authorization field count is exactly zero.
// Pair req.headerCount("Authorization") with req.authorization.or(""). A nil
// singleton value alone also means duplicates and is not proof of absence.
func apiKeyOrAnonymous(_ authorizationCount: i32, _ authorization: str, _ key: str,
                       _ consumerId: str, _ credentialId: str, _ anonymousId: str) -> Identity {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard key != "" && consumerId != "" && credentialId != "" && anonymousId != "" &&
          consumerId != anonymousId else { respond 503 }
    guard authorizationCount == 1 || (authorizationCount == 0 && authorization == "") else { respond denied }
    guard authorizationCount == 0 || bearerMatches(authorization, key) else { respond denied }
    match authorizationCount {
        0 => Identity(consumerId: anonymousId, credentialId: "", method: "anonymous")
        _ => Identity(consumerId: consumerId, credentialId: credentialId, method: "apiKey")
    }
}

// Signature verification remains a distinct step from claims policy.
func jwtDocument(_ authorization: str, _ secret: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard secret != "" else { respond 503 }
    guard let document = Crypto.jwtAny(bearerToken(authorization).or(""), secret) else { respond denied }
    document
}

// Bind a key to one trusted algorithm; select the helper explicitly in configuration.
func jwtDocumentHs256(_ authorization: str, _ secret: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard secret != "" else { respond 503 }
    guard let document = Crypto.jwtHs256(bearerToken(authorization).or(""), secret) else { respond denied }
    document
}

func jwtDocumentHs384(_ authorization: str, _ secret: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard secret != "" else { respond 503 }
    guard let document = Crypto.jwtHs384(bearerToken(authorization).or(""), secret) else { respond denied }
    document
}

func jwtDocumentHs512(_ authorization: str, _ secret: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard secret != "" else { respond 503 }
    guard let document = Crypto.jwtHs512(bearerToken(authorization).or(""), secret) else { respond denied }
    document
}

struct JwtSubject { sub: str }
struct JwtTokenId { jti: str }

// Pass only a document already verified by jwtDecode; this helper applies claims
// policy and maps the verified subject, keeping signature verification explicit.
func jwtIdentity(_ document: Json, _ issuer: str, _ audience: str, _ credentialId: str) -> Identity {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard issuer != "" && audience != "" && credentialId != "" else { respond 503 }
    guard jwtClaimsValid(document, issuer, audience) else { respond denied }
    guard let subject = json.decode(JwtSubject, document) else { respond denied }
    Identity(consumerId: subject.sub, credentialId: credentialId, method: "jwt")
}

// Use only after signature and issuer/audience/time validation. Each configured
// ID belongs to the same trusted issuer as the verified claims; empty slots are
// disabled. Changing this static snapshot requires a configuration reload.
func requireUnrevokedJwt(_ document: Json, _ first: str, _ second: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer error=\"invalid_token\"")
    guard let token = json.decode(JwtTokenId, document) else { respond denied }
    guard token.jti != "" && (first == "" || token.jti != first) &&
          (second == "" || token.jti != second) else { respond denied }
    document
}

// OR composition for one consumer during a migration between Bearer and Basic.
// Empty credentials disable that method; both disabled is a configuration error.
// Use one unique Authorization field, never retry another source after rejection.
func apiKeyOrBasic(_ authorization: str, _ key: str, _ credentials: str,
                   _ consumerId: str, _ keyId: str, _ passwordId: str) -> Identity {
    let denied = response(401)
    denied.add("WWW-Authenticate", "Bearer")
    denied.add("WWW-Authenticate", "Basic realm=\"rut\"")
    guard consumerId != "" && keyId != "" && passwordId != "" && (key != "" || credentials != "") else { respond 503 }
    let keyMatches = bearerMatches(authorization, key)
    let passwordMatches = basicMatches(authorization, credentials)
    guard keyMatches || passwordMatches else { respond denied }
    match keyMatches {
        true => Identity(consumerId: consumerId, credentialId: keyId, method: "apiKey")
        _ => Identity(consumerId: consumerId, credentialId: passwordId, method: "basic")
    }
}

// Authorization runs AFTER authentication. Identity must come from a verifier.
// Exact, case-sensitive IDs: no substring, wildcard, or client-header matching.
func requireConsumer(_ identity: Identity, _ allowedConsumerId: str) -> Identity {
    guard allowedConsumerId != "" else { respond 503 }
    guard identity.consumerId == allowedConsumerId else { respond 403 }
    identity
}

// Union of two exact configured IDs. Authenticate before calling this helper.
// Repeated requireConsumer calls are intersections, so cannot express this union.
func requireAnyConsumer(_ identity: Identity, _ first: str, _ second: str) -> Identity {
    guard first != "" && second != "" else { respond 503 }
    guard identity.consumerId == first || identity.consumerId == second else { respond 403 }
    identity
}

// Chain deny checks for multiple excluded consumers; denial terminates the route.
func denyConsumer(_ identity: Identity, _ deniedConsumerId: str) -> Identity {
    guard deniedConsumerId != "" else { respond 503 }
    guard identity.consumerId != deniedConsumerId else { respond 403 }
    identity
}

// Fixed HMAC-SHA256 over the caller's EXACT signed bytes, canonical lowercase hex.
// This is integrity/authentication only: replay policy belongs to the protocol.
func hmac(_ message: str, _ signature: str, _ key: str,
          _ consumerId: str, _ credentialId: str) -> Identity {
    guard key != "" && consumerId != "" && credentialId != "" else { respond 503 }
    guard Crypto.hmacSha256Valid(message, key, signature, "") else { respond 401 }
    Identity(consumerId: consumerId, credentialId: credentialId, method: "hmac")
}

// GitHub X-Hub-Signature-256 must be a UNIQUE header. Verify raw body before JSON
// parsing or transformations. Never accept a bare digest or SHA-1 fallback.
func githubWebhook(_ body: str, _ signature: str, _ key: str,
                   _ consumerId: str, _ credentialId: str) -> Identity {
    guard key != "" && consumerId != "" && credentialId != "" else { respond 503 }
    guard Crypto.hmacSha256Valid(body, key, signature, "sha256=") else { respond 401 }
    Identity(consumerId: consumerId, credentialId: credentialId, method: "hmac")
}

// Standard Webhooks v1. Pass singleton webhook-id, webhook-timestamp and
// webhook-signature values, the exact raw body, and trusted decoded key bytes.
// The key is not the whsec_ wire encoding. Freshness is bounded to 300 seconds;
// receivers still need durable deduplication before performing side effects.
func standardWebhook(_ id: str, _ timestamp: str, _ signature: str, _ body: str,
                     _ rawKey: str, _ consumerId: str, _ credentialId: str) -> Identity {
    guard rawKey != "" && consumerId != "" && credentialId != "" else { respond 503 }
    guard Crypto.webhookValid(id, timestamp, signature, body, rawKey) else { respond 401 }
    Identity(consumerId: consumerId, credentialId: credentialId, method: "standardWebhook")
}

// Both slots are evaluated. Current wins if configured secrets are identical.
func rotatingHmac(_ message: str, _ signature: str, _ currentKey: str, _ previousKey: str,
                  _ consumerId: str, _ currentId: str, _ previousId: str) -> Identity {
    guard consumerId != "" && currentId != "" && previousId != "" else { respond 503 }
    guard currentKey != "" || previousKey != "" else { respond 503 }
    let current = Crypto.hmacSha256Valid(message, currentKey, signature, "")
    let previous = Crypto.hmacSha256Valid(message, previousKey, signature, "")
    guard current || previous else { respond 401 }
    match current {
        true => Identity(consumerId: consumerId, credentialId: currentId, method: "hmac")
        _ => Identity(consumerId: consumerId, credentialId: previousId, method: "hmac")
    }
}

// Trusted static membership snapshot; an empty group disables that slot.
struct ConsumerGroups {
    consumerId: str
    first: str
    second: str
}

func validGroupMember(_ member: ConsumerGroups) -> bool {
    member.consumerId != "" &&
        (member.first == "" || member.second == "" || member.first != member.second)
}

// Membership is bound to the verified identity, never to a request header.
// The bounded registry holds two distinct consumers; no match denies by default.
func requireGroup(_ identity: Identity, _ required: str,
                  _ first: ConsumerGroups, _ second: ConsumerGroups) -> Identity {
    guard required != "" && validGroupMember(first) && validGroupMember(second) &&
        first.consumerId != second.consumerId else { respond 503 }
    let firstMatches = identity.consumerId == first.consumerId &&
        (required == first.first || required == first.second)
    let secondMatches = identity.consumerId == second.consumerId &&
        (required == second.first || required == second.second)
    guard firstMatches || secondMatches else { respond 403 }
    identity
}

// policy is trusted compile-time JSON (literal, constant, or env snapshot):
// {"issuer":"...","audience":"...","kids":["..."],"jwks":{"keys":[...]}}.
// Unlike jwtDocumentHs*, this verifies issuer/audience/time/sub before returning.
// Pass req.authorization.or("") so duplicate Authorization fields fail closed.
func jwtDocumentRs256(_ authorization: str, _ policy: str) -> Json {
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard let document = Crypto.jwtRs256(bearerToken(authorization).or(""), policy) else { respond denied }
    document
}

// The credentialId names this configured issuer/key policy, not a claim or
// attacker-provided header. All approved rotation keys share that trust policy.
// Publish an identity only after both authentication and scope authorization.
func jwtIdentityRs256(_ authorization: str, _ policy: str, _ scope: str,
                     _ credentialId: str) -> Identity {
    guard credentialId != "" && scope != "" else { respond 503 }
    let document = jwtDocumentRs256(authorization, policy)
    let forbidden = response(403)
    forbidden.set("WWW-Authenticate", "Bearer error=\"insufficient_scope\"")
    guard jwtHasScope(document, scope) else { respond forbidden }
    guard let subject = json.decode(JwtSubject, document) else { respond 401 }
    Identity(consumerId: subject.sub, credentialId: credentialId, method: "jwtRS256")
}
