// PASSWORD_HASH is a freshly salted record produced by the native password_hash
// provisioning API. It is fixed at compilation/load time and required to be valid.
// Run: PASSWORD_HASH='...' build/src/rut 8080 examples/password-header-auth.rut --shards 1
// This example uses a dedicated unique header as its credential transport.
route GET "/ready" { return 204 }
route POST "/login" {
    let result = passwordVerifyHeader("X-Password", env("PASSWORD_HASH"), 5000)
    guard result != -1 else { return 503 }
    guard result != -2 else { return 504 }
    guard result == 1 else { return 401 }
    return 200
}
