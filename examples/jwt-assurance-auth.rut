import "middleware/jwt_assurance.rut"

listen :8080

// These independent routes demonstrate trusted policies on verified JWT claims.
func checkedDocument(_ authorization: str) -> Json {
    let secret = env("JWT_SECRET")
    guard Bytes(secret).count >= 32 && Bytes(secret).count <= 4096 else { respond 503 }
    let denied = response(401)
    denied.set("WWW-Authenticate", "Bearer")
    guard let token = bearerToken(authorization) else { respond denied }
    guard let document = jwtDecode(token, secret, "HS256") else { respond denied }
    guard jwtClaimsValid(document, "https://issuer.example", "orders") else { respond denied }
    document
}

route GET "/acr" {
    let document = checkedDocument(req.authorization.or(""))
    let allowed = jwt_assurance.requireAcr(document, env("JWT_REQUIRED_ACR"))
    return 204
}

route GET "/amr" {
    let document = checkedDocument(req.authorization.or(""))
    let allowed = jwt_assurance.requireAmr(document, env("JWT_REQUIRED_AMR"))
    return 204
}

route GET "/auth-age" {
    let document = checkedDocument(req.authorization.or(""))
    let allowed = jwt_assurance.requireAuthenticationAge(document, parseInt(env("JWT_MAX_AUTH_AGE")).or(0))
    return 204
}

route GET "/email" {
    let document = checkedDocument(req.authorization.or(""))
    let allowed = jwt_assurance.requireVerifiedEmail(document, env("JWT_VERIFIED_EMAIL"))
    return 204
}

route GET "/session" {
    let document = checkedDocument(req.authorization.or(""))
    let allowed = jwt_assurance.requireSession(document, env("JWT_REQUIRED_SESSION"))
    return 204
}

route "/" { return 404 }
