// JWT authentication with the runtime signature primitive and Rut-owned policy.
//
// jwtDecode verifies HS256/384/512 and returns the claims object as Json?.
// Expiry and role checks stay in Rut so deployments can choose their own
// policy. This slice takes the raw token from X-JWT; Bearer-prefix parsing
// needs the string prefix/slice builtins, which are still roadmap. The HMAC
// secret is resolved from the environment when the program is compiled/loaded.

listen :8080
upstream api at "127.0.0.1:9000"

struct Claims {
    sub: str
    role: str
    exp: Json
}

route GET "/admin" {
    let token = req.header("X-JWT").or("")
    guard let document = jwtDecode(token, env("JWT_SECRET")) else {
        return 401
    }
    guard let claims = json.decode(Claims, document) else { return 401 }
    guard let expires = json.int(claims.exp) else { return 401 }
    guard expires * i64(1000000) > time.nowMicros() else { return 401 }
    guard claims.role == "admin" else { return 403 }

    return forward(api)
}
