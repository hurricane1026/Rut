// INTROSPECTION_ENDPOINT: a fixed httpCall HTTPS policy for the token endpoint.
// INTROSPECTION_AUTH: trusted Basic/Bearer service authorization, never a client header.
// Serve client traffic over TLS or through a trusted TLS-terminating frontend.
import "middleware/introspection.rut"
listen :8080
upstream backend at "127.0.0.1:9000"

route GET "/reports" {
    let request = introspection.request(req.authorization.or(""), env("INTROSPECTION_AUTH"))
    let pending = httpCall(env("INTROSPECTION_ENDPOINT"), request, 1000)
    guard let reply = pending else { return 503 }
    let document = introspection.requireActive(reply, "reports-api")
    let authorized = introspection.requireScope(document, "reports:read")
    let subject = introspection.subject(authorized)
    match subject != "" {
        true => {
            req.remove("Authorization")
            req.set("X-Consumer-ID", subject)
            return forward(backend, load_balance: .roundRobin)
        }
        _ => { return 401 }
    }
}

// Opt-in issuer/client binding. Configure both from trusted resource policy.
route GET "/bound-reports" {
    let request = introspection.request(req.authorization.or(""), env("INTROSPECTION_AUTH"))
    let pending = httpCall(env("INTROSPECTION_ENDPOINT"), request, 1000)
    guard let reply = pending else { return 503 }
    let document = introspection.requireActive(reply, "reports-api")
    let bound = introspection.requireBinding(document, env("TOKEN_ISSUER"), env("TOKEN_CLIENT_ID"))
    let subject = introspection.subject(bound)
    match jwtHasScope(bound, "reports:read") {
        true => {
            req.remove("Authorization")
            req.set("X-Consumer-ID", subject)
            return forward(backend, load_balance: .roundRobin)
        }
        _ => {
            return response(403, headers: {"WWW-Authenticate": "Bearer error=\"insufficient_scope\""})
        }
    }
}

// Permissions are trusted route policy, never selected by request headers.
route GET "/read-or-write-reports" {
    let request = introspection.request(req.authorization.or(""), env("INTROSPECTION_AUTH"))
    let pending = httpCall(env("INTROSPECTION_ENDPOINT"), request, 1000)
    guard let reply = pending else { return 503 }
    let document = introspection.requireActive(reply, "reports-api")
    let authorized = introspection.requireEitherScope(document, "reports:read", "reports:write")
    let subject = introspection.subject(authorized)
    match subject != "" {
        true => {
            req.remove("Authorization")
            req.set("X-Consumer-ID", subject)
            return forward(backend, load_balance: .roundRobin)
        }
        _ => { return 401 }
    }
}

// Permissions are trusted route policy, never selected by request headers.
route GET "/read-and-write-reports" {
    let request = introspection.request(req.authorization.or(""), env("INTROSPECTION_AUTH"))
    let pending = httpCall(env("INTROSPECTION_ENDPOINT"), request, 1000)
    guard let reply = pending else { return 503 }
    let document = introspection.requireActive(reply, "reports-api")
    let authorized = introspection.requireBothScopes(document, "reports:read", "reports:write")
    let subject = introspection.subject(authorized)
    match subject != "" {
        true => {
            req.remove("Authorization")
            req.set("X-Consumer-ID", subject)
            return forward(backend, load_balance: .roundRobin)
        }
        _ => { return 401 }
    }
}
