let buckets = Cache<IP, i64>(capacity: 4096)

route GET "/limited" {
    let now = time.nowMicros()
    let tat = max(buckets.get(req.remoteAddr).or(0), now)
    if tat - now <= 600000000 {
        buckets.set(req.remoteAddr, tat + 600000000)
        return 200
    } else {
        return 429
    }
}
