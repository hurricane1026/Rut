// Provision records with rut-password; see docs/password-provisioning.md.
// One configured account. Set PASSWORD_HASH, PASSWORD_SUBJECT and JWT_ISSUE_KEY
// at compilation/load time; JWT_ISSUE_KEY must have at least 32 random bytes.
// Provision PASSWORD_HASH offline with password_hash's random-salt overload.
// Serve over TLS. Credentials and resolved keys are present in native artifacts.
import "middleware/auth.rut"

route GET "/ready" { return 204 }

// Five immediate attempts, then one per 12 seconds per client IP, shared across
// this process's shards. Failed/missing/duplicate credentials also spend budget.
// Use the socket peer IP; never a client-supplied forwarding or identity header.
@rateLimit(limit: 5, window: 1m, burst: 5, by: ip, scope: global)
route POST "/login" {
    let result = passwordVerifyHeader("X-Password", env("PASSWORD_HASH"), 5000)
    let identity = auth.passwordIdentity(result, env("PASSWORD_SUBJECT"), "password-v1")
    let requestId = uuid()
    guard let tokenId = requestId else { return 503 }
    guard let token = auth.jwtForIdentityHs256WithIdAndScope(
        identity, "rut-password-login", "orders", tokenId,
        "orders.read", env("JWT_ISSUE_KEY"), 300) else { return 503 }
    return response(200, body: token, headers: {
        "Content-Type": "application/jwt",
        "Cache-Control": "no-store",
        "Pragma": "no-cache"
    })
}

route GET "/private" {
    let claims = auth.jwtDocumentHs256(req.authorization.or(""), env("JWT_ISSUE_KEY"))
    let identity = auth.jwtIdentityWithLifetime(
        claims, "rut-password-login", "orders", "login-jwt", 300, 300)
    guard jwtHasScope(claims, "orders.read") else { return 403 }
    let subject = identity.consumerId
    return response(200, body: subject, headers: {"Cache-Control": "no-store"})
}
