diff --git a/tests/test_network.cc b/tests/test_network.cc
index aa6c0042..8b626f81 100644
--- a/tests/test_network.cc
+++ b/tests/test_network.cc
@@ -75833,6 +75833,73 @@ struct UserspaceSendWaitFixture {
     ~UserspaceSendWaitFixture() { backend.destroy_send_state_storage(); }
 };
 
+TEST(iouring_send_zc, holds_completion_until_notification_and_retries_partial) {
+    UserspaceSendWaitFixture f;
+    REQUIRE(f.init());
+    auto& b = f.backend;
+    static const u8 payload[] = "abcdefghi";
+    b.send_state[0] = {payload, 91, 0, 9, IoEventType::Send, 0, 41};
+    b.send_state[0].zerocopy = true;
+    IoEvent event{};
+    REQUIRE(f.push(41, 4, IORING_CQE_F_MORE));
+    CHECK_EQ(b.wait(&event, 1, nullptr, 0), 0u);
+    CHECK(b.send_state[0].notification_pending);
+    CHECK_EQ(b.send_state[0].offset, 0u);
+    CHECK_EQ(b.pending, 0u);
+    // Cancel-token and old-generation notifications cannot release this owner.
+    REQUIRE(f.push(40, 0, IORING_CQE_F_NOTIF));
+    REQUIRE(f.push(41 | kNonUpstreamSendCancelBit, -ENOENT));
+    CHECK_EQ(b.wait(&event, 1, nullptr, 0), 1u);
+    CHECK(b.send_state[0].notification_pending);
+    REQUIRE(f.push(41, IORING_NOTIF_USAGE_ZC_COPIED, IORING_CQE_F_NOTIF));
+    CHECK_EQ(b.wait(&event, 1, nullptr, 0), 0u);
+    CHECK(!b.send_state[0].notification_pending);
+    CHECK_EQ(b.send_state[0].offset, 4u);
+    CHECK_EQ(b.send_state[0].remaining, 5u);
+    CHECK_EQ(b.pending, 1u);
+    CHECK_EQ(f.sq_entries[0].opcode, IORING_OP_SEND_ZC);
+    b.pending = 0;  // queued SQE is simulated, not submitted to a kernel
+    REQUIRE(f.push(41, 5, IORING_CQE_F_MORE));
+    CHECK_EQ(b.wait(&event, 1, nullptr, 0), 0u);
+    CHECK_EQ(b.send_state[0].remaining, 5u);
+    REQUIRE(f.push(41, 0, IORING_CQE_F_NOTIF));
+    CHECK_EQ(b.wait(&event, 1, nullptr, 0), 1u);
+    CHECK_EQ(event.result, 9);
+    CHECK_EQ(event.more, 0u);
+    CHECK_EQ(event.non_upstream_generation, 41u);
+    CHECK_EQ(b.send_zc_notifications, 2u);
+    CHECK_EQ(b.send_zc_copied, 1u);
+}
+
+TEST(iouring_send_zc, unsupported_falls_back_and_error_waits_for_notification) {
+    UserspaceSendWaitFixture f;
+    REQUIRE(f.init());
+    auto& b = f.backend;
+    static const u8 payload[] = "abcdefghi";
+    IoEvent event{};
+    b.send_state[0] = {payload, 91, 0, 9, IoEventType::Send, 0, 42};
+    b.send_state[0].zerocopy = true;
+    REQUIRE(f.push(42, -EOPNOTSUPP));
+    CHECK_EQ(b.wait(&event, 1, nullptr, 0), 0u);
+    CHECK(!b.send_state[0].zerocopy);
+    CHECK_EQ(f.sq_entries[0].opcode, IORING_OP_SEND);
+    CHECK_EQ(b.send_state[0].remaining, 9u);
+    b.pending = 0;  // simulate submission of the fallback
+    REQUIRE(f.push(42, 9));
+    REQUIRE_EQ(b.wait(&event, 1, nullptr, 0), 1u);
+    CHECK_EQ(event.result, 9);
+    b.send_state[0] = {payload, 91, 0, 9, IoEventType::Send, 0, 43};
+    b.send_state[0].zerocopy = true;
+    REQUIRE(f.push(43, -ECANCELED, IORING_CQE_F_MORE));
+    CHECK_EQ(b.wait(&event, 1, nullptr, 0), 0u);
+    CHECK(b.send_state[0].notification_pending);
+    REQUIRE(f.push(43, 0, IORING_CQE_F_NOTIF));
+    REQUIRE_EQ(b.wait(&event, 1, nullptr, 0), 1u);
+    CHECK_EQ(event.result, -ECANCELED);
+    CHECK_EQ(event.non_upstream_generation, 43u);
+    CHECK(!b.send_state[0].notification_pending);
+}
