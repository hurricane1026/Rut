+TEST(response_buffering_runtime, pinned_parse_cache_rechecks_bytes_and_policy) {
+    RouteConfig config{};
+    REQUIRE(add_bodyless_non_head_response_read_deadline_bundle(
+        config, 5, ForwardResponseBufferingMode::CompleteContentLength));
+    config.response_policies[0].server = {"nginx/1.29.7", 12};
+    u8 storage[512]{};
+    Connection conn{};
+    conn.reset();
+    conn.request_config = &config;
+    conn.response_policy_id = 1;
+    conn.resp_status = 200;
+    conn.response_read_deadline_upload.downstream_close = false;
+    conn.response_header_buf.bind(storage, sizeof(storage));
+    static constexpr u8 kHeader[] =
+        "HTTP/1.1 200 OK\r\nServer: nginx/1.29.7\r\nContent-Length: 4\r\n"
+        "Connection: keep-alive\r\n\r\n";
+    REQUIRE_EQ(conn.response_header_buf.write(kHeader, sizeof(kHeader) - 1u), sizeof(kHeader) - 1u);
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+
+    // Same address and length, but an invalid status line; restoration must
+    // also recover after the failed parse invalidates the cache.
+    storage[0] = 'X';
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 4));
+    storage[0] = 'H';
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+
+    // A valid changed Content-Length must be parsed again as well.
+    constexpr u32 kLengthAt =
+        sizeof("HTTP/1.1 200 OK\r\nServer: nginx/1.29.7\r\nContent-Length: ") - 1u;
+    storage[kLengthAt] = '5';
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 4));
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 5));
+    storage[kLengthAt] = '4';
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+
+    conn.resp_status = 201;
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 4));
+    conn.resp_status = 200;
+    conn.response_read_deadline_upload.downstream_close = true;
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 4));
+    conn.response_read_deadline_upload.downstream_close = false;
+    const Str server = config.response_policies[0].server;
+    config.response_policies[0].server = {"other", 5};
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 4));
+    config.response_policies[0].server = server;
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+
+    // Identical bytes at another address must not retain views into storage.
+    u8 other[512]{};
+    conn.response_header_buf.bind(other, sizeof(other));
+    REQUIRE_EQ(conn.response_header_buf.write(kHeader, sizeof(kHeader) - 1u), sizeof(kHeader) - 1u);
+    __builtin_memset(storage, 'X', sizeof(storage));
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+
+    // Large headers bypass the bounded cache, including repeated checks and
+    // in-place mutation, with exactly the same semantic validation.
+    conn.response_header_buf.reset();
+    REQUIRE_EQ(conn.response_header_buf.write(kHeader, sizeof(kHeader) - 3u), sizeof(kHeader) - 3u);
+    static constexpr u8 kExtra[] = "X-Padding: ";
+    conn.response_header_buf.write(kExtra, sizeof(kExtra) - 1u);
+    for (u32 i = 0; i < 256; ++i)
+        conn.response_header_buf.write(reinterpret_cast<const u8*>("a"), 1);
+    conn.response_header_buf.write(reinterpret_cast<const u8*>("\r\n\r\n"), 4);
+    REQUIRE_GT(conn.response_header_buf.len(), 256u);
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 4));
+    other[0] = 'X';
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 4));
+}
