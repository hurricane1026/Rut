 namespace rut {
 
+// Experimental bounded syscall bursts; preserve one logical file-send completion.
+static ssize_t send_file_bursts(i32 fd, i32 file_fd, off_t* pos, u32 len) {
+    u32 written = 0;
+    while (written < len) {
+        const u32 remaining = len - written;
+        const u32 batch = remaining < 256u * 1024u ? remaining : 256u * 1024u;
+        const ssize_t n = ::sendfile(fd, file_fd, pos, batch);
+        if (n <= 0) return written != 0 ? static_cast<ssize_t>(written) : n;
+        written += static_cast<u32>(n);
+        if (static_cast<u32>(n) < batch) break;
+    }
+    return static_cast<ssize_t>(written);
+}
