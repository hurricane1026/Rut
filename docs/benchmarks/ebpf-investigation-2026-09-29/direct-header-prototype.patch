+TEST(iouring_upstream_recv, direct_header_target_survives_stale_episode_and_rejects_drift) {
+    for (u32 mode = 0; mode < 4; ++mode) {
+        ScopedIoUringLoopForRetirement guard;
+        if (!guard.init()) SKIP("io_uring unavailable");
+        auto* loop = guard.loop;
+        auto& backend = loop->backend;
+        OneShotRecvFixture fixture;
+        REQUIRE(fixture.stage(loop, /*plaintext=*/true));
+        Connection& conn = *fixture.conn;
+        u8* const dst = conn.upstream_recv_buf.write_ptr();
+        constexpr u32 kLen = 32;
+        REQUIRE_GE(conn.upstream_recv_buf.write_avail(), kLen);
+        conn.response_read_deadline_generation = 7;
+        REQUIRE(backend.add_recv_upstream_direct(
+            conn.upstream_fd, conn.id, conn.upstream_episode, dst, kLen, true));
+        const auto& sqe = backend.sq_entries[fixture.sq_tail_before & *backend.sq_ring_mask];
+        CHECK_EQ(sqe.addr, reinterpret_cast<u64>(dst));
+        CHECK_EQ(sqe.len, kLen);
+        CHECK_EQ(sqe.flags & IOSQE_BUFFER_SELECT, 0u);
+        CHECK_NE(sqe.ioprio & IORING_RECVSEND_POLL_FIRST, 0u);
+        conn.upstream_recv_direct_armed = true;
+        conn.upstream_recv_armed = true;
+        conn.pending_ops++;
+        conn.upstream_header_direct_dst = dst;
+        conn.upstream_header_direct_len = kLen;
+        conn.upstream_header_direct_episode = conn.upstream_episode;
+        conn.upstream_header_direct_generation = 7;
+        fixture.restore_ring();
+        backend.pending = 0;
+        auto complete = [&](i32 result, u32 episode, IoEvent* ev) {
+            const u32 tail = __atomic_load_n(backend.cq_tail, __ATOMIC_ACQUIRE);
+            auto& cqe = backend.cq_entries[tail & *backend.cq_ring_mask];
+            cqe.user_data = encode_upstream_event_token(
+                {conn.id, IoEventType::UpstreamRecv, episode, 0});
+            cqe.res = result;
+            cqe.flags = 0;
+            __atomic_store_n(backend.cq_tail, tail + 1u, __ATOMIC_RELEASE);
+            return backend.wait(ev, 1, loop->conns, IoUringEventLoop::kMaxConns);
+        };
+        IoEvent ev{};
+        REQUIRE_EQ(complete(kLen, conn.upstream_episode + 1, &ev), 1u);
+        CHECK(conn.upstream_recv_direct_armed);
+        CHECK_EQ(conn.upstream_header_direct_dst, dst);
+        CHECK_EQ(conn.upstream_recv_buf.len(), 0u);
+        for (u32 i = 0; i < kLen; ++i) dst[i] = static_cast<u8>(i + 1);
+        if (mode == 1) conn.upstream_recv_buf.commit(1);  // write pointer drift
+        if (mode == 2) ++conn.response_read_deadline_generation;
+        REQUIRE_EQ(complete(mode == 3 ? -ECANCELED : kLen, conn.upstream_episode, &ev), 1u);
+        CHECK_FALSE(conn.upstream_recv_direct_armed);
+        CHECK_EQ(conn.upstream_header_direct_dst, nullptr);
+        CHECK_EQ(conn.upstream_header_direct_len, 0u);
+        CHECK_EQ(conn.upstream_recv_buf.len(), mode == 0 ? kLen : (mode == 1 ? 1u : 0u));
+        if (mode == 0) {
+            for (u32 i = 0; i < kLen; ++i)
+                CHECK_EQ(conn.upstream_recv_buf.data()[i], static_cast<u8>(i + 1));
+        }
+        conn.upstream_recv_armed = false;
+        conn.pending_ops--;
+        fixture.cleanup();
+    }
+}
