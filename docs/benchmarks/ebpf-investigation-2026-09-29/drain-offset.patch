+TEST(early_response, retired_bounded_header_drain_preserves_storage_and_restores_capacity) {
+    SmallLoop loop;
+    loop.setup();
+    loop.inject_and_dispatch(make_ev(0, IoEventType::Accept, 42));
+    auto* c = loop.find_fd(42);
+    REQUIRE(c != nullptr);
+    REQUIRE(loop.alloc_upstream_buf(*c));
+    u8* base = c->upstream_recv_slice;
+    const u32 capacity = c->upstream_recv_buf.capacity();
+    for (u32 mode = 0; mode < 4; ++mode) {
+        c->upstream_recv_buf.reset();
+        for (u32 i = 0; i < 300; ++i) base[i] = static_cast<u8>(i);
+        c->upstream_recv_buf.commit(300);
+        c->response_read_deadline_buffering = ForwardResponseBufferingMode::Bounded;
+        c->response_read_deadline_post_commit_phase =
+            ResponseReadDeadlinePostCommitPhase::HeaderSend;
+        c->response_read_deadline_post_commit_raw_header_end = 100;
+        c->upstream_fd = -1;
+        c->upstream_abandoned = mode != 3;
+        c->upstream_recv_armed = mode == 1;
+        c->upstream_recv_direct_armed = mode == 2;
+        c->upstream_send_len = 100;
+        CHECK_EQ(consume_upstream_sent(*c), 200u);
+        CHECK_EQ(c->upstream_recv_buf.data(), base + (mode == 0 ? 100 : 0));
+        CHECK_EQ(c->upstream_recv_buf.capacity(), capacity - (mode == 0 ? 100 : 0));
+        CHECK_EQ(c->upstream_recv_drain_offset, mode == 0 ? 100u : 0u);
+        if (mode == 0) CHECK_EQ(base[0], 0u);
+        for (u32 i = 0; i < 200; ++i)
+            CHECK_EQ(c->upstream_recv_buf.data()[i], static_cast<u8>(i + 100));
+        c->response_read_deadline_post_commit_phase = ResponseReadDeadlinePostCommitPhase::BodySend;
+        c->upstream_send_len = 50;
+        CHECK_EQ(consume_upstream_sent(*c), 150u);
+        for (u32 i = 0; i < 150; ++i)
+            CHECK_EQ(c->upstream_recv_buf.data()[i], static_cast<u8>(i + 150));
+        c->upstream_send_len = 150;
+        CHECK_EQ(consume_upstream_sent(*c), 0u);
+        CHECK_EQ(c->upstream_recv_buf.data(), base);
+        CHECK_EQ(c->upstream_recv_buf.capacity(), capacity);
+        CHECK_EQ(c->upstream_recv_buf.write_avail(), capacity);
+        CHECK_EQ(c->upstream_recv_drain_offset, 0u);
+    }
+    c->upstream_recv_armed = false;
+    c->upstream_recv_direct_armed = false;
+}
