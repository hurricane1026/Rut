+                            u8* previous = conn.send_slice;
+                            conn.send_slice = expanded;
+                            conn.send_buf.bind(expanded, kFilePrefixCapacity);
+                            conn.send_buf.commit(header_len);
+                            loop->pool.free(previous);
+                        }
+                    }
+                }
                 const u32 n =
