+TEST(http_header_compare, exhaustive_ascii_case_equivalence) {
+    for (u32 a = 0; a < 256; ++a) {
+        for (u32 b = 0; b < 256; ++b) {
+            const char left = static_cast<char>(a);
+            const char right = static_cast<char>(b);
+            const u32 folded_a = a >= 'A' && a <= 'Z' ? a + 32 : a;
+            const u32 folded_b = b >= 'A' && b <= 'Z' ? b + 32 : b;
+            CHECK_EQ(http_header_name_eq_ci(&left, 1, &right, 1), folded_a == folded_b);
+        }
+    }
+    CHECK(http_header_name_eq_ci(nullptr, 0, nullptr, 0));
+    CHECK(http_header_name_eq_ci("Content-TyPe", 12, "content-type", 12));
+    CHECK(!http_header_name_eq_ci("Content-Type", 12, "content-type!", 13));
+    CHECK(!http_header_name_eq_ci("abc@", 4, "abc`", 4));
+    CHECK(!http_header_name_eq_ci("abc[", 4, "abc{", 4));
+    CHECK(!http_header_name_eq_ci("abc^", 4, "abc~", 4));
+    CHECK(!http_header_name_eq_ci("abc", 3, "abd", 3));
+}
+
 int main(int argc, char** argv) {
     return rut::test::run_all(argc, argv);
 }
