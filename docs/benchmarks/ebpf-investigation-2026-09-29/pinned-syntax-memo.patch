+// Cache only parsing, never a policy or ownership verdict. Exact bytes and
+// length are checked every time; oversized headers use the ordinary parser.
+inline bool parse_pinned_response_header(const Connection& c, ParsedResponse& parsed) {
+    const u8* bytes = c.response_header_buf.data();
+    const u32 length = c.response_header_buf.len();
+    if (bytes == nullptr || length == 0 || length > c.response_header_buf.capacity()) return false;
+    auto& memo = c.pinned_header_memo;
+    if (length == memo.length && length <= Connection::PinnedHeaderMemo::kCapacity &&
+        __builtin_memcmp(bytes, memo.bytes, length) == 0) {
+        auto view = [&](Connection::PinnedHeaderMemo::View v) -> Str {
+            return {reinterpret_cast<const char*>(bytes + v.offset), v.length};
+        };
+        parsed.version = memo.version;
+        parsed.reason = view(memo.reason);
+        parsed.status_code = memo.status;
+        parsed.header_count = memo.header_count;
+        parsed.content_length = memo.content_length;
+        parsed.content_length_count = memo.content_length_count;
+        parsed.has_content_length = memo.has_content_length;
+        parsed.chunked = memo.chunked;
+        parsed.keep_alive = memo.keep_alive;
+        parsed.connection_close = memo.connection_close;
+        parsed.headers_truncated = memo.headers_truncated;
+        for (u32 i = 0; i < memo.header_count; ++i) {
+            parsed.headers[i].name = view(memo.headers[i].name);
+            parsed.headers[i].value = view(memo.headers[i].value);
+            parsed.headers[i].raw_value = view(memo.headers[i].raw_value);
+        }
+        return true;
+    }
+    HttpResponseParser parser;
+    parser.reset();
+    parsed.reset();
+    if (parser.parse(bytes, length, &parsed) != ParseStatus::Complete ||
+        parser.header_end != length || parsed.version != HttpVersion::Http11)
+        return false;
+    if (length <= Connection::PinnedHeaderMemo::kCapacity &&
+        parsed.header_count <= Connection::PinnedHeaderMemo::kHeaders) {
+        auto offset = [&](Str v) -> Connection::PinnedHeaderMemo::View {
+            return {static_cast<u16>(reinterpret_cast<const u8*>(v.ptr) - bytes),
+                    static_cast<u16>(v.len)};
+        };
+        memo.length = 0;
+        memo.version = parsed.version;
+        memo.reason = offset(parsed.reason);
+        memo.status = parsed.status_code;
+        memo.header_count = static_cast<u8>(parsed.header_count);
+        memo.content_length = parsed.content_length;
+        memo.content_length_count = parsed.content_length_count;
+        memo.has_content_length = parsed.has_content_length;
+        memo.chunked = parsed.chunked;
+        memo.keep_alive = parsed.keep_alive;
+        memo.connection_close = parsed.connection_close;
+        memo.headers_truncated = parsed.headers_truncated;
+        for (u32 i = 0; i < parsed.header_count; ++i) {
+            memo.headers[i] = {offset(parsed.headers[i].name), offset(parsed.headers[i].value),
+                               offset(parsed.headers[i].raw_value)};
+        }
+        __builtin_memcpy(memo.bytes, bytes, length);
+        memo.length = length;
+    }
+    return true;
+}
