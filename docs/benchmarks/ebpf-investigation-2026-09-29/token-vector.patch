+TEST(http_parser, header_name_scanner_matches_scalar_all_bytes_and_boundaries) {
+    auto token = [](u8 c) {
+        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+               (c != 0 && __builtin_strchr("!#$%&'*+-.^_`|~", c) != nullptr);
+    };
+    auto scalar = [&](const u8* buf, u32 pos, u32 end) -> u32 {
+        for (; pos < end; ++pos) {
+            if (buf[pos] == ':') return pos;
+            if (!token(buf[pos])) return static_cast<u32>(-1);
+        }
+        return static_cast<u32>(-1);
+    };
+    constexpr u32 lengths[] = {0, 1, 15, 16, 17, 31, 32, 33, 63, 64, 65};
+    u8 buf[160];
+    for (u32 start = 0; start < 32; ++start) {
+        for (u32 len : lengths) {
+            const u32 colon = start + len;
+            const u32 positions[] = {start, start + len / 2, colon, colon + 1};
+            for (u32 at : positions) {
+                for (u32 byte = 0; byte < 256; ++byte) {
+                    __builtin_memset(buf, 'A', sizeof(buf));
+                    buf[colon] = ':';
+                    buf[at] = static_cast<u8>(byte);
+                    CHECK_EQ(simd::scan_header_name(buf, start, colon + 1),
+                             scalar(buf, start, colon + 1));
+                    CHECK_EQ(simd::scan_header_name(buf, start, sizeof(buf)),
+                             scalar(buf, start, sizeof(buf)));
+                }
+            }
+        }
+    }
+}
