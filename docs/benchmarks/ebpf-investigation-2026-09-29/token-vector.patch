+// One bit per high nibble, indexed by low nibble. Both AVX2 lanes
+// use the same table; bytes outside ASCII have no matching high-nibble bit.
+struct TokenNibbleMasks {
+    alignas(32) u8 bytes[32]{};
+    constexpr TokenNibbleMasks() {
+        for (u32 c = 0; c < 128; ++c) {
+            if (kTokenTable[c]) {
+                bytes[c & 15] |= static_cast<u8>(1u << (c >> 4));
+                bytes[16 + (c & 15)] = bytes[c & 15];
+            }
+        }
+    }
+};
+static constexpr TokenNibbleMasks kTokenNibbleMasks{};
