+#ifdef __linux__
+TEST(pinned_header_memo, parsing_matches_fresh_parser_after_rebind_and_byte_mutations) {
+    const char* headers[] = {
+        "HTTP/1.1 200 OK\r\nServer: rut\r\nContent-Length: 3\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\n",
+        "HTTP/1.1 206 Partial Content\r\nServer: rut\r\nContent-Length: 3\r\nConnection: close\r\nContent-Range: bytes 4294967300-4294967302/8589934592\r\n\r\n",
+        "HTTP/1.1 200 \r\nX-Empty:\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\n",
+        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nX-Test: \t value \t\r\n\r\n",
+        "HTTP/1.1 200 OK\r\nX-1: a\r\nX-2: b\r\nX-3: c\r\nX-4: d\r\nX-5: e\r\nX-6: f\r\nX-7: g\r\nX-8: h\r\nX-9: i\r\n\r\n",
+    };
+    Connection conn{};
+    conn.reset();
+    u8 storage[2048];
+    u8 relocated[2048];
+    auto check = [&]() {
+        HttpResponseParser parser;
+        ParsedResponse expected;
+        parser.reset();
+        expected.reset();
+        const bool valid = parser.parse(conn.response_header_buf.data(),
+                                       conn.response_header_buf.len(), &expected) == ParseStatus::Complete &&
+                           parser.header_end == conn.response_header_buf.len() &&
+                           expected.version == HttpVersion::Http11;
+        ParsedResponse actual;
+        const bool cached = parse_pinned_response_header(conn, actual);
+        CHECK_EQ(cached, valid);
+        if (!cached || !valid) return;
+        CHECK_EQ(actual.version, expected.version);
+        CHECK(actual.reason.eq(expected.reason));
+        CHECK_EQ(actual.status_code, expected.status_code);
+        CHECK_EQ(actual.header_count, expected.header_count);
+        CHECK_EQ(actual.content_length, expected.content_length);
+        CHECK_EQ(actual.content_length_count, expected.content_length_count);
+        CHECK_EQ(actual.has_content_length, expected.has_content_length);
+        CHECK_EQ(actual.chunked, expected.chunked);
+        CHECK_EQ(actual.keep_alive, expected.keep_alive);
+        CHECK_EQ(actual.connection_close, expected.connection_close);
+        CHECK_EQ(actual.headers_truncated, expected.headers_truncated);
+        for (u32 i = 0; i < actual.header_count; ++i) {
+            CHECK(actual.headers[i].name.eq(expected.headers[i].name));
+            CHECK(actual.headers[i].value.eq(expected.headers[i].value));
+            CHECK(actual.headers[i].raw_value.eq(expected.headers[i].raw_value));
+            CHECK(actual.headers[i].name.ptr == expected.headers[i].name.ptr);
+            CHECK(actual.headers[i].value.ptr == expected.headers[i].value.ptr);
+        }
+    };
+    for (const char* header : headers) {
+        const u32 len = static_cast<u32>(strlen(header));
+        conn.response_header_buf.bind(storage, sizeof(storage));
+        REQUIRE_EQ(conn.response_header_buf.write(reinterpret_cast<const u8*>(header), len), len);
+        check();
+        check();
+        for (u32 i = 0; i < len; ++i) {
+            storage[i] ^= 1;
+            check();
+            storage[i] ^= 1;
+            check();
+        }
+        conn.response_header_buf.bind(relocated, sizeof(relocated));
+        REQUIRE_EQ(conn.response_header_buf.write(storage, len), len);
+        check();
+        check();
+    }
+    const std::string long_header = "HTTP/1.1 200 OK\r\nX-Long: " + std::string(600, 'x') + "\r\n\r\n";
+    conn.response_header_buf.bind(storage, sizeof(storage));
+    REQUIRE_EQ(conn.response_header_buf.write(reinterpret_cast<const u8*>(long_header.data()),
+                                              static_cast<u32>(long_header.size())), long_header.size());
+    check();
+    check();
+}
