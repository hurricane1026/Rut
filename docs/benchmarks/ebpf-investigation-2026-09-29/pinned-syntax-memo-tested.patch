+TEST(pinned_header_memo, policy_and_request_mutations_still_reject_warm_header) {
+    RouteConfig config{};
+    ForwardResponsePolicySpec policy{};
+    policy.version = ResponsePolicyVersion::Http11;
+    policy.framing = ResponsePolicyFraming::ContentLength;
+    policy.connection = ResponsePolicyConnection::Request;
+    policy.date = ResponsePolicyDate::Current;
+    policy.server = {"rut", 3};
+    REQUIRE_EQ(config.add_response_policy(policy), 1u);
+    Connection conn{};
+    conn.reset();
+    conn.request_config = &config;
+    conn.response_policy_id = 1;
+    conn.resp_status = 206;
+    conn.response_read_deadline_upload.downstream_close = true;
+    u8 storage[512];
+    const u8 header[] = "HTTP/1.1 206 Partial Content\r\nServer: rut\r\nContent-Length: 3\r\nConnection: close\r\nContent-Type: text/plain\r\nContent-Range: bytes 4294967300-4294967302/8589934592\r\n\r\n";
+    conn.response_header_buf.bind(storage, sizeof(storage));
+    REQUIRE_EQ(conn.response_header_buf.write(header, sizeof(header) - 1), sizeof(header) - 1);
+    CompleteContentLengthResponseClassification classification{};
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 3, &classification));
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 3, &classification));
+    CHECK_EQ(classification.first, 4294967300ull);
+    CHECK_EQ(classification.total, 8589934592ull);
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 4));
+    conn.resp_status = 200;
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 3));
+    conn.resp_status = 206;
+    conn.response_read_deadline_upload.downstream_close = false;
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 3));
+    conn.response_read_deadline_upload.downstream_close = true;
+    conn.response_policy_id = 0;
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 3));
+    conn.response_policy_id = 1;
+    conn.request_config = nullptr;
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 3));
+    conn.request_config = &config;
+    const auto saved = config.response_policies[0];
+    config.response_policies[0].server = {"foo", 3};
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 3));
+    config.response_policies[0] = saved;
+    config.response_policies[0].hide_header_count = 1;
+    config.response_policies[0].hide_headers[0] = {"Content-Type", 12};
+    CHECK_FALSE(complete_content_length_pinned_header_matches(conn, 3));
+    config.response_policies[0] = saved;
+    REQUIRE(complete_content_length_pinned_header_matches(conn, 3));
+    conn.reset();
+    CHECK_EQ(conn.pinned_header_memo.length, 0u);
+}
